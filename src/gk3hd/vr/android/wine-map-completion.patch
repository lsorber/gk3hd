diff --git a/dlls/wined3d/cs.c b/dlls/wined3d/cs.c
index 83c74c5..ab2d257 100644
--- a/dlls/wined3d/cs.c
+++ b/dlls/wined3d/cs.c
@@ -2492,7 +2492,11 @@ HRESULT wined3d_device_context_emit_map(struct wined3d_device_context *context,
         struct wined3d_map_desc *map_desc, const struct wined3d_box *box, unsigned int flags)
 {
     struct wined3d_cs_map *op;
-    HRESULT hr;
+    /* The compatibility host translates x86's queue publication to ARM64.
+     * Keep the result alive until its worker write is actually observed. */
+    const HRESULT pending = (HRESULT)0xe17e4a91;
+    HRESULT hr = pending;
+    unsigned int spin_count = 0;
 
     /* Mapping resources from the worker thread isn't an issue by itself, but
      * increasing the map count would be visible to applications. */
@@ -2526,6 +2530,9 @@ HRESULT wined3d_device_context_emit_map(struct wined3d_device_context *context,
     wined3d_device_context_submit(context, WINED3D_CS_QUEUE_MAP);
     wined3d_device_context_finish(context, WINED3D_CS_QUEUE_MAP);
 
+    while (InterlockedCompareExchange(&hr, 0, 0) == pending)
+        wined3d_pause(&spin_count);
+
     if (SUCCEEDED(hr))
         wined3d_resource_get_sub_resource_map_pitch(resource, sub_resource_idx,
                 &map_desc->row_pitch, &map_desc->slice_pitch);
