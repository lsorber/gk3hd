+// Explicit off-head debugging only. Capture the first three projection pairs
+// before composition (six cropped eyes, under 96 MiB in total). This
+// never runs in ordinary headset play or changes pose validity.
+static void CaptureProjectionInputs(rt::Session& session,const XrCompositionLayerProjection& projection) {
+    static const bool enabled=GetEnvironmentVariableA("GK3HD_XR_CAPTURE_EYES",nullptr,0)>0;
+    static uint32_t projectionFrame=0;
+    if(!enabled) return;
+    const uint32_t frame=++projectionFrame;
+    if(frame>3) return;
+    static const ULONGLONG captureToken=GetTickCount64();
+    std::ofstream index(RuntimeDirectory()/"diagnostic-eye-index.txt",
+        std::ios::binary|(frame==1 ? std::ios::trunc : std::ios::app));
+    if(frame==1) index<<captureToken<<'\n';
+    for(unsigned eye=0;eye<2;eye++) {
+        const auto& sub=projection.views[eye].subImage;
+        auto found=rt::g_swapchains.find(sub.swapchain);
+        if(found==rt::g_swapchains.end()) return;
+        const auto& chain=found->second;
+        const auto& rect=sub.imageRect;
+        const bool rgba8=chain.vkFormat==VK_FORMAT_R8G8B8A8_UNORM || chain.vkFormat==VK_FORMAT_R8G8B8A8_SRGB ||
+            chain.vkFormat==VK_FORMAT_B8G8R8A8_UNORM || chain.vkFormat==VK_FORMAT_B8G8R8A8_SRGB;
+        if(!rgba8 || chain.lastReleased>=chain.imagesVK.size() || sub.imageArrayIndex!=0 ||
+           !gk3hd::standalone::projectionCaptureFits(chain.width,chain.height,
+               rect.offset.x,rect.offset.y,rect.extent.width,rect.extent.height))
+            throw std::runtime_error("Unsupported diagnostic eye region or resource extent");
+        std::vector<uint8_t> bytes;
+        if(!VulkanReadbackPixels(session.vkDevice,session.vkPhysicalDevice,session.vkCmdPool,session.vkQueue,
+            chain.imagesVK[chain.lastReleased],chain.vkFormat,chain.width,chain.height,bytes))
+            throw std::runtime_error("Diagnostic eye readback failed");
+        bool bgra=chain.vkFormat==VK_FORMAT_B8G8R8A8_SRGB || chain.vkFormat==VK_FORMAT_B8G8R8A8_UNORM;
+        auto rgb=gk3hd::standalone::projectionCaptureRgb(bytes,chain.width,chain.height,
+            rect.offset.x,rect.offset.y,rect.extent.width,rect.extent.height,bgra);
+        size_t nonblack=0;
+        for(size_t i=0;i<rgb.size();i+=3) nonblack+=(rgb[i]|rgb[i+1]|rgb[i+2])!=0;
+        auto name="diagnostic-eye-"+std::to_string(captureToken)+"-"+std::to_string(frame)+"-"+std::to_string(eye)+".ppm";
+        std::ofstream file(RuntimeDirectory()/name,std::ios::binary);
+        file<<"P6\n"<<rect.extent.width<<' '<<rect.extent.height<<"\n255\n";
+        file.write(reinterpret_cast<const char*>(rgb.data()),rgb.size());
+        if(!file) throw std::runtime_error("Diagnostic eye file write failed");
+        index<<name<<'\n';
+        Logf("[GK3HD] Diagnostic input eye frame=%u eye=%u nonblack=%u extent=%ux%u format=%d",
+            frame,eye,unsigned(nonblack),unsigned(rect.extent.width),unsigned(rect.extent.height),int(chain.vkFormat));
+    }
+}
