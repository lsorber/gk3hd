+#include <android/log.h>
+#include <time.h>
+#include <sys/syscall.h>
+
+// Opt-in, per-RPC-thread aggregates. No clocks or per-call logging when off.
+typedef struct Gk3hdRequestMetric {uint64_t calls, bytes, wall, cpu, maximum;} Gk3hdRequestMetric;
+typedef struct Gk3hdRequestProfile {
+    Gk3hdRequestMetric metrics[REQUEST_CODE_VK_CALL_COUNT];
+    uint64_t start, receiveWall, receiveCpu, dispatchWall, dispatchCpu, calls;
+    unsigned reports;
+} Gk3hdRequestProfile;
+static uint64_t gk3hdClock(clockid_t clock) {
+    struct timespec now;clock_gettime(clock,&now);return (uint64_t)now.tv_sec*1000000000ull+now.tv_nsec;
+}
+static void gk3hdReportRequests(Gk3hdRequestProfile* profile,bool final) {
+    if(!profile||!profile->calls||profile->reports>=24) return;
+    uint64_t now=gk3hdClock(CLOCK_MONOTONIC);
+    if(!final&&now-profile->start<2000000000ull) return;
