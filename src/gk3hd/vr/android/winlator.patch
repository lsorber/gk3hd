 JNIEXPORT jlong JNICALL
+Java_com_winlator_renderer_GPUImage_createCompressedHardwareBuffer(JNIEnv *env, jobject obj, jshort width, jshort height) {
+    if (width <= 0 || height <= 0 || width > 8192 || height > 4096) return 0;
+    /* Request the Qualcomm-compressed layout through COMPOSER_CLIENT_TARGET. */
+    const AHardwareBuffer_Desc request = {.width=width,.height=height,.layers=1,
+        .format=AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM,
+        .usage=AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT|AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE|(UINT64_C(1)<<12)};
+    AHardwareBuffer *buffer=NULL;
+    if (AHardwareBuffer_allocate(&request,&buffer)!=0 || !buffer) return 0;
+    AHardwareBuffer_Desc actual;
+    AHardwareBuffer_describe(buffer,&actual);
+    const native_handle_t *handle=AHardwareBuffer_getNativeHandle(buffer);
+    const uint32_t qcom=((uint32_t)'g'<<24)|((uint32_t)'m'<<16)|((uint32_t)'s'<<8)|'m';
+    bool compressed_layout=false;
+    if (handle && handle->version==(int)sizeof(*handle) && handle->numFds==2 && handle->data[0]>=0) {
+        if (handle->numInts>=2 && (uint32_t)handle->data[2]==qcom &&
+                ((uint32_t)handle->data[3]&UINT32_C(0x08000000))) {
+            compressed_layout=true;
+        } else if (handle->numInts==27) {
+            const off_t bytes=lseek(handle->data[0],0,SEEK_END);
+            if (bytes>0 && lseek(handle->data[0],0,SEEK_SET)==0) {
+                compressed_layout=gk3hd_qcom_versioned_rgba_layout(handle->version,handle->numFds,
+                    handle->numInts,handle->data+handle->numFds,actual.width,actual.height,
+                    actual.stride,actual.format,actual.layers,actual.usage,bytes);
+            }
+        }
+    }
+    if (!compressed_layout ||
+        actual.width!=(uint32_t)width || actual.height!=(uint32_t)height || actual.stride<(uint32_t)width || actual.stride>8192 ||
+        actual.layers!=1 || actual.format!=request.format) {
+        AHardwareBuffer_release(buffer);
+        return 0;
+    }
+    jclass cls=(*env)->GetObjectClass(env,obj);
+    jmethodID stride=(*env)->GetMethodID(env,cls,"setStride","(S)V");
+    jmethodID fd=(*env)->GetMethodID(env,cls,"setNativeHandle","(I)V");
+    if (!stride || !fd) {
+        AHardwareBuffer_release(buffer);
+        return 0;
+    }
+    (*env)->CallVoidMethod(env,obj,stride,(jshort)actual.stride);
+    (*env)->CallVoidMethod(env,obj,fd,handle->data[0]);
+    return (jlong)buffer;
+}
