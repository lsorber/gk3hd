diff --git a/app/src/main/cpp/winlator/src/gk3hd_jni.c b/app/src/main/cpp/winlator/src/gk3hd_jni.c
new file mode 100644
index 0000000..ae634d9
--- /dev/null
+++ b/app/src/main/cpp/winlator/src/gk3hd_jni.c
@@ -0,0 +1,25 @@
+#include "gk3hd_jni.h"
+
+jint gk3hd_register_methods(JNIEnv *env, const char *class_name,
+                            const JNINativeMethod *methods, jint count) {
+    jclass type = (*env)->FindClass(env, class_name);
+    if (!type) return JNI_ERR;
+    jint result = (*env)->RegisterNatives(env, type, methods, count);
+    (*env)->DeleteLocalRef(env, type);
+    return result;
+}
+
+// Android 8–11 cannot resolve CriticalNative methods by symbol name.
+JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM *vm, void *reserved) {
+    JNIEnv *env;
+    (void)reserved;
+    if ((*vm)->GetEnv(vm, (void **)&env, JNI_VERSION_1_6) != JNI_OK)
+        return JNI_ERR;
+    if (
+        gk3hd_register_xinput_stream(env) != JNI_OK ||
+        gk3hd_register_xoutput_stream(env) != JNI_OK ||
+        gk3hd_register_xconnector_epoll(env) != JNI_OK ||
+        gk3hd_register_gpu_helper(env) != JNI_OK)
+        return JNI_ERR;
+    return JNI_VERSION_1_6;
+}
