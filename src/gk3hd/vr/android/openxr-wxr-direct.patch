+static uint32_t AcquireDirectPreview(rt::Session& s) {
+    if (s.directImage != UINT32_MAX) {
+        FailDirectPreview(s, "acquire with an outstanding borrowed image");
+        return UINT32_MAX;
+    }
+    if(s.vkPreviewNeedsRebuild || s.vkPrepareCmds.empty()) return UINT32_MAX;
+    const uint64_t timeout=StandalonePreviewTimeoutNs();
+    uint32_t index=UINT32_MAX;
+    const VkResult reset = vkResetFences(s.vkDevice, 1, &s.vkAcquireFence);
+    if (reset != VK_SUCCESS) {
+        Logf("[GK3HD] Direct acquire fence reset failed: %d", int(reset));
+        FailDirectPreview(s, "reset direct acquire fence");
+        return UINT32_MAX;
+    }
+    auto result=vkAcquireNextImageKHR(s.vkDevice,s.vkPreviewSwapchain,timeout,VK_NULL_HANDLE,s.vkAcquireFence,&index);
+    if(result!=VK_SUCCESS && result!=VK_SUBOPTIMAL_KHR) {
+        Logf("[GK3HD] Direct acquire failed result=%d",int(result));
+        if(result!=VK_TIMEOUT && result!=VK_NOT_READY) {
+            FailDirectPreview(s, "acquire direct image");
+        }
+        return UINT32_MAX;
+    }
+    auto fail=[&](VkResult error) {
+        Logf("[GK3HD] Direct prepare failed result=%d index=%u",int(error),index);
+        FailDirectPreview(s, "prepare direct image");
+        return UINT32_MAX;
+    };
+    result=vkWaitForFences(s.vkDevice,1,&s.vkAcquireFence,VK_TRUE,timeout);
+    if(result!=VK_SUCCESS || index>=s.vkPreviewImages.size()) return fail(result);
+    if(s.vkBlitSubmitted[index]) {
+        result=vkWaitForFences(s.vkDevice,1,&s.vkBlitFences[index],VK_TRUE,timeout);
+        if(result!=VK_SUCCESS) return fail(result);
+    }
+    s.vkProducerAdmission.retired(index);
+    VkCommandBuffer command=s.vkPrepareCmds[index];
+    result=vkResetCommandBuffer(command,0);
+    if(result!=VK_SUCCESS) return fail(result);
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags=VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    result=vkBeginCommandBuffer(command,&begin);
+    if(result!=VK_SUCCESS) return fail(result);
+    VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    barrier.oldLayout=VK_IMAGE_LAYOUT_UNDEFINED;
+    barrier.newLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    barrier.dstAccessMask=VK_ACCESS_COLOR_ATTACHMENT_READ_BIT|VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    barrier.srcQueueFamilyIndex=barrier.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;
+    barrier.image=s.vkPreviewImages[index];
+    barrier.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};
+    vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+        0,0,nullptr,0,nullptr,1,&barrier);
+    result=vkEndCommandBuffer(command);
+    if(result!=VK_SUCCESS) return fail(result);
+    VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit.commandBufferCount=1;
+    submit.pCommandBuffers=&command;
+    result=vkQueueSubmit(s.vkQueue,1,&submit,VK_NULL_HANDLE);
+    if(result!=VK_SUCCESS) return fail(result);
+    return s.directImage=index;
+}
