+#ifdef HAVE_X11_DRM
+static VkResult
+x11_winlator_image_init(struct x11_swapchain *chain,
+                        const VkSwapchainCreateInfoKHR *create,
+                        struct x11_image *image)
+{
+   if (create->imageArrayLayers != 1 || !create->imageExtent.width ||
+       !create->imageExtent.height || create->imageExtent.width > UINT16_MAX ||
+       create->imageExtent.height > UINT16_MAX ||
+       (create->imageFormat != VK_FORMAT_B8G8R8A8_UNORM &&
+        create->imageFormat != VK_FORMAT_B8G8R8A8_SRGB))
+   {
+      mesa_loge("gk3hd native unsupported format=%u layers=%u size=%ux%u",
+         create->imageFormat, create->imageArrayLayers,
+         create->imageExtent.width, create->imageExtent.height);
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   }
+   VkResult result = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   image->pixmap = xcb_generate_id(chain->conn);
+   xcb_void_cookie_t cookie = xcb_create_pixmap_checked(chain->conn,
+      chain->depth, image->pixmap, chain->window,
+      create->imageExtent.width, create->imageExtent.height);
+   xcb_generic_error_t *error = xcb_request_check(chain->conn, cookie);
+   if (error) {
+      free(error);
+      image->pixmap = 0;
+      return VK_ERROR_SURFACE_LOST_KHR;
+   }
+   xcb_dri3_buffer_from_pixmap_cookie_t query =
+      xcb_dri3_buffer_from_pixmap(chain->conn, image->pixmap);
+   xcb_dri3_buffer_from_pixmap_reply_t *reply =
+      xcb_dri3_buffer_from_pixmap_reply(chain->conn, query, &error);
+   int fd = -1;
+   if (!error && reply && reply->nfd == 1) {
+      fd = xcb_dri3_buffer_from_pixmap_reply_fds(chain->conn, reply)[0];
+      /* This server's private protocol reports pixels, not DRI3 byte stride. */
+      uint64_t bytes = (uint64_t)reply->stride * reply->height * 4;
+      mesa_logi("gk3hd native reply pixmap=%u fd=%d nfd=%u bpp=%u width=%u height=%u stride=%u size=%u",
+         image->pixmap, fd, reply->nfd, reply->bpp, reply->width, reply->height,
+         reply->stride, reply->size);
+      if (fd >= 0 && reply->bpp == 32 &&
+          reply->width == create->imageExtent.width &&
+          reply->height == create->imageExtent.height &&
+          reply->stride >= reply->width && bytes <= reply->size) {
+         struct wsi_image_info info = chain->base.image_info;
+         info.create.extent.width = reply->stride;
+         info.create.tiling = VK_IMAGE_TILING_LINEAR;
+         info.winlator_import_fd = fd;
+         info.winlator_row_pitch = (uint32_t)reply->stride * 4;
+         result = wsi_create_image(&chain->base, &info, &image->base);
+         mesa_logi("gk3hd native image result=%d", result);
+         if (result == VK_SUCCESS)
+            mesa_logi("gk3hd native image pixmap=%u width=%u height=%u rowPitch=%u",
+               image->pixmap, reply->width, reply->height, info.winlator_row_pitch);
+      }
+   } else if (reply) {
+      mesa_loge("gk3hd native invalid reply nfd=%u error=%u", reply->nfd,
+         error ? error->error_code : 0);
+      int *fds = xcb_dri3_buffer_from_pixmap_reply_fds(chain->conn, reply);
+      for (uint32_t i = 0; i < reply->nfd; i++)
+         close(fds[i]);
+   }
+   if (fd >= 0)
+      close(fd);
+   free(error);
+   free(reply);
+   if (result == VK_SUCCESS)
+      return result;
+   cookie = xcb_free_pixmap(chain->conn, image->pixmap);
+   xcb_discard_reply(chain->conn, cookie.sequence);
+   image->pixmap = 0;
+   return result;
+}
+#endif
