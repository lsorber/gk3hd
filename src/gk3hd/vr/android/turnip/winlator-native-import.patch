+/* Private Winlator contract: distinct server-owned DMA-BUF per pixmap. */
+static VkResult
+wsi_create_winlator_image_mem(const struct wsi_swapchain *chain,
+                              const struct wsi_image_info *info,
+                              struct wsi_image *image,
+                              const VkMemoryRequirements *reqs)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   if (info->winlator_import_fd < 0 || !wsi->GetMemoryFdPropertiesKHR)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   /* dma-buf documents SEEK_END/SEEK_SET for size discovery. Its
+    * anonymous inode need not expose that size through fstat(). */
+   const off_t backing_size = lseek(info->winlator_import_fd, 0, SEEK_END);
+   const int size_errno = errno;
+   const off_t reset = lseek(info->winlator_import_fd, 0, SEEK_SET);
+   if (backing_size <= 0 || reset != 0 ||
+       (uint64_t)backing_size < reqs->size) {
+      mesa_loge("gk3hd native backing seek size=%lld errno=%d reset=%lld required=%llu",
+         (long long)backing_size, size_errno, (long long)reset,
+         (unsigned long long)reqs->size);
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+   VkMemoryFdPropertiesKHR properties = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+   };
+   VkResult result = wsi->GetMemoryFdPropertiesKHR(chain->device,
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      info->winlator_import_fd, &properties);
+   if (result != VK_SUCCESS)
+      return result;
+   uint32_t bits = reqs->memoryTypeBits & properties.memoryTypeBits;
+   if (!bits)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   const VkImageSubresource subresource = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT};
+   VkSubresourceLayout layout;
+   wsi->GetImageSubresourceLayout(chain->device, image->image, &subresource, &layout);
+   if (layout.rowPitch != info->winlator_row_pitch || layout.offset != 0 ||
+       layout.size > (uint64_t)backing_size) {
+      mesa_loge("gk3hd native layout pitch=%llu expected=%u offset=%llu size=%llu backing=%llu",
+         (unsigned long long)layout.rowPitch, info->winlator_row_pitch,
+         (unsigned long long)layout.offset, (unsigned long long)layout.size,
+         (unsigned long long)backing_size);
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+   int imported = os_dupfd_cloexec(info->winlator_import_fd);
+   if (imported < 0)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   const VkImportMemoryFdInfoKHR fd_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = imported,
+   };
+   const VkMemoryDedicatedAllocateInfo dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &fd_info,
+      .image = image->image,
+   };
+   const VkMemoryAllocateInfo allocation = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &dedicated,
+      .allocationSize = reqs->size,
+      .memoryTypeIndex = wsi_select_device_memory_type(wsi, bits),
+   };
+   result = wsi->AllocateMemory(chain->device, &allocation, &chain->alloc, &image->memory);
+   if (result != VK_SUCCESS) {
+      close(imported); /* Vulkan takes this FD only on success. */
+      return result;
+   }
+   image->dma_buf_fd = os_dupfd_cloexec(info->winlator_import_fd);
+   if (image->dma_buf_fd < 0)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   image->drm_modifier = DRM_FORMAT_MOD_INVALID;
+   image->num_planes = 1;
+   image->sizes[0] = reqs->size;
+   image->row_pitches[0] = layout.rowPitch;
+   image->offsets[0] = 0;
+   return VK_SUCCESS;
+}
