 #ifdef HAVE_X11_DRM
 static VkResult
+x11_import_winlator_compressed(struct x11_swapchain *chain, struct x11_image *image,
+                               const VkSwapchainCreateInfoKHR *create)
+{
+   xcb_generic_error_t *error = NULL;
+   xcb_dri3_buffers_from_pixmap_cookie_t cookie =
+      xcb_dri3_buffers_from_pixmap(chain->conn, image->pixmap);
+   xcb_dri3_buffers_from_pixmap_reply_t *reply =
+      xcb_dri3_buffers_from_pixmap_reply(chain->conn, cookie, &error);
+   VkResult result = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   if (!error && reply && reply->nfd == 1 && reply->length == 2 &&
+       reply->bpp == 32 && reply->depth == 32 &&
+       reply->modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED &&
+       reply->width == create->imageExtent.width && reply->height == create->imageExtent.height) {
+      const uint32_t stride = xcb_dri3_buffers_from_pixmap_strides(reply)[0];
+      const uint32_t offset = xcb_dri3_buffers_from_pixmap_offsets(reply)[0];
+      const int fd = xcb_dri3_buffers_from_pixmap_reply_fds(chain->conn, reply)[0];
+      if (fd >= 0 && stride >= (uint32_t)reply->width * 4 && stride <= 8192u * 4 && !(stride % 4) && offset == 0) {
+         struct wsi_image_info info = chain->base.image_info;
+         const VkSubresourceLayout plane = {.rowPitch = stride};
+         const VkImageDrmFormatModifierExplicitCreateInfoEXT modifier = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+            .pNext = info.create.pNext,
+            .drmFormatModifier = reply->modifier,
+            .drmFormatModifierPlaneCount = 1,
+            .pPlaneLayouts = &plane,
+         };
+         info.create.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+         info.create.pNext = &modifier;
+         info.winlator_import_fd = fd;
+         info.winlator_row_pitch = stride;
+         result = wsi_create_image(&chain->base, &info, &image->base);
+      }
+   }
+   if (reply) {
+      int *fds = xcb_dri3_buffers_from_pixmap_reply_fds(chain->conn, reply);
+      for (unsigned i = 0; i < reply->nfd; i++) close(fds[i]);
+   }
+   free(error);
+   free(reply);
+   return result;
+}
