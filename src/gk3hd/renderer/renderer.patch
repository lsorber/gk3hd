+  std::optional<HRESULT> DDrawCommonSurface::DownloadCPURegion(const RECT* requested) {
+    if (!IsRenderTarget() || !IsInitialized() || !IsD3D9SurfaceDirty() || IsDepthStencil()) return std::nullopt;
+    auto backing = GetCPUBacking();
+    if (!backing) return std::nullopt;
+    RECT region = requested ? *requested : m_rect;
+    IntersectRect(&region,&region,&m_rect);
+    // Batch nearby CPU reads: GK3 draws text one character at a time. Reading
+    // one small tile per glyph would introduce many GPU synchronization points.
+    if (requested && !IsRectEmpty(&region)) {
+      region.left = 0;
+      region.right = m_rect.right;
+      constexpr LONG readbackBandHeight = 256;
+      region.top = (region.top / readbackBandHeight) * readbackBandHeight;
+      region.bottom = std::min(m_rect.bottom, ((region.bottom + readbackBandHeight - 1) / readbackBandHeight) * readbackBandHeight);
+    }
+    auto missing = SubtractRegions({region},m_cpuValidRegions);
+    if (missing.empty()) return DD_OK;
+    if (EqualRect(&region,&m_rect)) {
+      // Preserve writes made in earlier partial locks before fetching the rest.
+      if (IsDDrawSurfaceDirty()) {
+        HRESULT hr = UploadCPURegions();
+        if (FAILED(hr)) return hr;
+      }
+      HRESULT hr = BlitToDDrawSurface<IDirectDrawSurface,DDSURFACEDESC>(backing,m_surface9.ptr(),false);
+      if (FAILED(hr)) return hr;
+      UnDirtyD3D9Surface();
+      m_cpuValidRegions = {m_rect};
+      return DD_OK;
+    }
+    auto dev = GetRefreshedD3D9Device();
+    if (!dev || !IsInitialized()) return DDERR_SURFACELOST;
+    for (const RECT& part : missing) {
+      const LONG width = part.right-part.left, height = part.bottom-part.top;
+      auto found = std::find_if(m_cpuReadbacks.begin(),m_cpuReadbacks.end(),[&](const CPUReadback& r){return r.width==width && r.height==height;});
+      if (found == m_cpuReadbacks.end()) {
+        CPUReadback entry = {width,height,{}};
+        HRESULT hr = dev->CreateRenderTarget(width,height,m_format9,d3d9::D3DMULTISAMPLE_NONE,0,TRUE,&entry.surface,nullptr);
+        if (FAILED(hr)) return hr;
+        if (m_cpuReadbacks.size() == 4) m_cpuReadbacks.erase(m_cpuReadbacks.begin());
+        m_cpuReadbacks.push_back(std::move(entry));
+        found = m_cpuReadbacks.end()-1;
+      }
+      HRESULT hr = dev->StretchRect(m_surface9.ptr(),&part,found->surface.ptr(),nullptr,d3d9::D3DTEXF_POINT);
+      if (FAILED(hr)) return hr;
+      d3d9::D3DLOCKED_RECT mapped;
+      hr = found->surface->LockRect(&mapped,nullptr,D3DLOCK_READONLY);
+      if (FAILED(hr)) return hr;
+      DDSURFACEDESC desc = {};
+      desc.dwSize = sizeof(desc);
+      RECT lockRect = part;
+      hr = backing->Lock(&lockRect,&desc,DDLOCK_WRITEONLY | DDLOCK_WAIT,nullptr);
+      if (FAILED(hr)) {
+        found->surface->UnlockRect();
+        return hr;
+      }
+      const size_t bytes = size_t(width)*desc.ddpfPixelFormat.dwRGBBitCount/8;
+      if (!desc.lpSurface || !mapped.pBits || !bytes || desc.lPitch <= 0 || mapped.Pitch <= 0 ||
+          size_t(desc.lPitch)<bytes || size_t(mapped.Pitch)<bytes) {
+        backing->Unlock(desc.lpSurface);
+        found->surface->UnlockRect();
+        return DDERR_INVALIDPARAMS;
+      }
+      for (LONG y=0;y<height;++y)
+        memcpy(static_cast<uint8_t*>(desc.lpSurface)+y*desc.lPitch,static_cast<uint8_t*>(mapped.pBits)+y*mapped.Pitch,bytes);
+      hr = backing->Unlock(desc.lpSurface);
+      HRESULT hr9 = found->surface->UnlockRect();
+      if (FAILED(hr)) return hr;
+      if (FAILED(hr9)) return hr9;
+      AddRegion(m_cpuValidRegions,part);
+    }
+    return DD_OK;
+  }
+
+  std::optional<HRESULT> DDrawCommonSurface::UploadCPUBacking() {
+    if (!IsRenderTarget() || !IsInitialized() || !IsDDrawSurfaceDirty() ||
+        m_commonD3DDevice->GetMultiSampleType() != d3d9::D3DMULTISAMPLE_NONE)
+      return std::nullopt;
+    if (!GetCPUBacking()) return std::nullopt;
+    if (m_cpuDirtyRegions.empty()) {
+      UnDirtyDDrawSurface();
+      return DD_OK;
+    }
+    return UploadCPURegions();
+  }
