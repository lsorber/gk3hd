+      const auto g = AreaBlendChannel(green + ((previous >> 5) & 63) * remain, denominator, inverse);
+      const auto b = AreaBlendChannel(blue + (previous & 31) * remain, denominator, inverse);
+      out[x] = uint16_t((r << 11) | (g << 5) | b);
+    }
+  }
+  return true;
+}
+}
diff --git a/src/ddraw/private_area_blt.h b/src/ddraw/private_area_blt.h
new file mode 100644
index 0000000..e435d16
--- /dev/null
+++ b/src/ddraw/private_area_blt.h
@@ -0,0 +1,73 @@
+#pragma once
+#include "private_stretch.h"
+
+namespace dxvk {
+// An explicit opaque operation, not a new default for ordinary DirectDraw Blt.
+// Rectangles are copied into the request; no caller pointers are retained.
+struct AreaBlt565Args {
+  uint32_t size;
+  IDirectDrawSurface* destination;
+  IDirectDrawSurface* source;
+  RECT destinationRect, sourceRect;
+  HRESULT result; // Written only when the export returns 1 (handled).
+};
+
+template<typename Surface>
+inline CPUStretchResult AreaBlt565Surface(Surface* destination, Surface* source, RECT dst, RECT src) {
+  if (!destination || !source || destination==source ||
+      src.left<0 || src.top<0 || src.right<=src.left || src.bottom<=src.top ||
+      dst.left<0 || dst.top<0 || dst.right<=dst.left || dst.bottom<=dst.top) return {};
+  const LONG sw=src.right-src.left,sh=src.bottom-src.top,dw=dst.right-dst.left,dh=dst.bottom-dst.top;
+  // Bound both work and integer products. At most 1024^2*63 fits uint32_t.
+  if (sw>1024 || sh>1024 || dw>sw || dh>sh || (dw==sw && dh==sh)) return {};
+  DDSURFACEDESC input{},output{};input.dwSize=output.dwSize=sizeof(input);
+  const auto rgb565=[](const DDPIXELFORMAT& p) {
+    return p.dwSize==sizeof(p) && p.dwFlags==DDPF_RGB && p.dwRGBBitCount==16 &&
+      p.dwRBitMask==0xf800 && p.dwGBitMask==0x7e0 && p.dwBBitMask==0x1f;
+  };
+  if (FAILED(source->GetSurfaceDesc(&input)) || FAILED(destination->GetSurfaceDesc(&output)) ||
+      !rgb565(input.ddpfPixelFormat) || !rgb565(output.ddpfPixelFormat) ||
+      uint64_t(src.right)>input.dwWidth || uint64_t(src.bottom)>input.dwHeight ||
+      uint64_t(dst.right)>output.dwWidth || uint64_t(dst.bottom)>output.dwHeight) return {};
+  HRESULT hr=source->Lock(&src,&input,DDLOCK_READONLY|DDLOCK_WAIT,nullptr);
+  if (FAILED(hr)) return {true,hr,false};
+  hr=destination->Lock(&dst,&output,DDLOCK_WRITEONLY|DDLOCK_WAIT,nullptr);
+  if (FAILED(hr)) {
+    source->Unlock(input.lpSurface);
+    return {true,hr,false};
+  }
+  input.dwWidth=sw;input.dwHeight=sh;output.dwWidth=dw;output.dwHeight=dh;
+  const bool valid=rgb565(input.ddpfPixelFormat) && rgb565(output.ddpfPixelFormat) &&
+    input.lpSurface && output.lpSurface && input.lPitch>=int64_t(sw)*2 && output.lPitch>=int64_t(dw)*2 &&
+    input.lPitch%2==0 && output.lPitch%2==0 &&
+    reinterpret_cast<uintptr_t>(input.lpSurface)%2==0 && reinterpret_cast<uintptr_t>(output.lpSurface)%2==0 &&
+    DisjointRGB565Storage(input,output);
+  if (valid) {
+    const uint32_t denominator=sw*sh;
+    for (LONG y=0;y<dh;++y) {
+      auto out=reinterpret_cast<uint16_t*>(static_cast<char*>(output.lpSurface)+size_t(y)*output.lPitch);
+      const LONG y0=y*sh,y1=y0+sh;
+      for (LONG x=0;x<dw;++x) {
+        const LONG x0=x*sw,x1=x0+sw;
+        uint32_t red=0,green=0,blue=0;
+        for (LONG sy=y0/dh;sy<(y1+dh-1)/dh;++sy) {
+          const auto in=reinterpret_cast<const uint16_t*>(static_cast<const char*>(input.lpSurface)+size_t(sy)*input.lPitch);
+          const LONG wy=std::min(y1,(sy+1)*dh)-std::max(y0,sy*dh);
+          for (LONG sx=x0/dw;sx<(x1+dw-1)/dw;++sx) {
+            const uint32_t weight=wy*(std::min(x1,(sx+1)*dw)-std::max(x0,sx*dw));
+            const uint16_t pixel=in[sx];
+            red+=(pixel>>11)*weight;green+=((pixel>>5)&63)*weight;blue+=(pixel&31)*weight;
+          }
+        }
+        out[x]=uint16_t((((red+denominator/2)/denominator)<<11)|
+          (((green+denominator/2)/denominator)<<5)|((blue+denominator/2)/denominator));
+      }
+    }
+  }
+  hr=destination->Unlock(output.lpSurface);
+  const HRESULT sourceResult=source->Unlock(input.lpSurface);
+  if (SUCCEEDED(hr)) hr=sourceResult;
+  // Completed writes cannot be retried via a different sampler after failure.
+  return {valid || FAILED(hr),hr,valid};
+}
+}
diff --git a/src/ddraw/private_locks.h b/src/ddraw/private_locks.h
new file mode 100644
index 0000000..00493b3
--- /dev/null
+++ b/src/ddraw/private_locks.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <windows.h>
+#include <ddraw.h>
+#include <algorithm>
+#include <vector>
+
+namespace dxvk {
+// Lock state belongs to the surface, not to an individual COM interface view.
+class SurfaceLockRegions {
+  struct Entry { RECT region; void* data; bool writable; bool full; };
+  std::vector<Entry> entries;
+  size_t ambiguousUnlocks=0;
+
+  template<typename Predicate> std::vector<RECT> complete(Predicate match) {
+    auto found=std::find_if(entries.begin(),entries.end(),match);
+    // Native DirectDraw accepts some single-lock calls with a different/NULL
+    // token. Honor a successful native Unlock without inventing a second lock.
+    if (found==entries.end() && entries.size()==1) found=entries.begin();
+    std::vector<RECT> dirty;
+    if (found!=entries.end()) {
+      if (found->writable) dirty.push_back(found->region);
+      entries.erase(found);
+    } else if (!entries.empty()) {
+      // If native code accepts an ambiguous token, conservatively retain every
+      // possible written region until all outstanding unlocks are accounted for.
+      for (const auto& entry:entries) if (entry.writable) dirty.push_back(entry.region);
+      ++ambiguousUnlocks;
+    }
+    if (ambiguousUnlocks>=entries.size()) {
+      entries.clear();
+      ambiguousUnlocks=0;
+    }
+    return dirty;
+  }
+public:
+  void add(const RECT* region,const RECT& full,void* data,DWORD flags) {
+    entries.push_back({region?*region:full,data,
+      !(flags&DDLOCK_READONLY) || bool(flags&DDLOCK_WRITEONLY),region==nullptr});
+  }
+  std::vector<RECT> byData(void* data) {
+    return complete([&](const Entry& entry){return data ? entry.data==data : entry.full;});
+  }
+  std::vector<RECT> byRect(const RECT* region) {
+    return complete([&](const Entry& entry){return region ? EqualRect(region,&entry.region) : entry.full;});
+  }
+  bool empty() const { return entries.empty(); }
+  void clear() { entries.clear(); ambiguousUnlocks=0; }
+};
+}
diff --git a/src/ddraw/private_native_copy.h b/src/ddraw/private_native_copy.h
new file mode 100644
index 0000000..c29fdd1
--- /dev/null
+++ b/src/ddraw/private_native_copy.h
@@ -0,0 +1,69 @@
+#pragma once
+#include <windows.h>
+#include <ddraw.h>
+#include <cstring>
+#include <cstdint>
+#include <algorithm>
+
+namespace dxvk {
+template<typename Input,typename Output>
+inline bool DisjointRGB565Storage(const Input& input, const Output& output) {
+  if (!input.dwWidth || !input.dwHeight || !output.dwWidth || !output.dwHeight) return false;
+  const uint64_t inputStart = reinterpret_cast<uintptr_t>(input.lpSurface);
+  const uint64_t outputStart = reinterpret_cast<uintptr_t>(output.lpSurface);
+  const uint64_t inputEnd = inputStart + uint64_t(input.lPitch) * (input.dwHeight-1) + uint64_t(input.dwWidth)*2;
+  const uint64_t outputEnd = outputStart + uint64_t(output.lPitch) * (output.dwHeight-1) + uint64_t(output.dwWidth)*2;
+  const uint64_t addressLimit = uint64_t(UINTPTR_MAX);
+  return inputEnd>inputStart && outputEnd>outputStart && inputEnd-1<=addressLimit && outputEnd-1<=addressLimit &&
+    (inputEnd<=outputStart || outputEnd<=inputStart);
+}
+// The caller has already checked format, flags, full rectangles and ownership.
+// Returning false leaves the destination unmodified for native Blt fallback.
+inline bool CopyLargeRGB565Surface(IDirectDrawSurface* destination, IDirectDrawSurface* source, HRESULT& result) {
+  DDSURFACEDESC input{},output{};
+  input.dwSize=output.dwSize=sizeof(input);
+  if (FAILED(source->Lock(nullptr,&input,DDLOCK_READONLY|DDLOCK_WAIT,nullptr))) return false;
+  if (FAILED(destination->Lock(nullptr,&output,DDLOCK_WRITEONLY|DDLOCK_WAIT,nullptr))) {
+    source->Unlock(nullptr);
+    return false;
+  }
+  const auto rgb565=[](const DDPIXELFORMAT& p) {
+    return p.dwFlags==DDPF_RGB && p.dwRGBBitCount==16 &&
+      p.dwRBitMask==0xf800 && p.dwGBitMask==0x7e0 && p.dwBBitMask==0x1f;
+  };
+  const bool valid=rgb565(input.ddpfPixelFormat) && rgb565(output.ddpfPixelFormat) &&
+    input.dwWidth==output.dwWidth && input.dwHeight==output.dwHeight &&
+    input.lpSurface && output.lpSurface && input.lpSurface!=output.lpSurface &&
+    input.lPitch>=int64_t(input.dwWidth)*2 && output.lPitch>=int64_t(output.dwWidth)*2 &&
+    DisjointRGB565Storage(input,output);
+  if (valid) {
+    for (DWORD y=0;y<output.dwHeight;++y)
+      memcpy(static_cast<char*>(output.lpSurface)+size_t(y)*output.lPitch,
+             static_cast<char*>(input.lpSurface)+size_t(y)*input.lPitch,size_t(output.dwWidth)*2);
+  }
+  result=destination->Unlock(nullptr);
+  const HRESULT sourceUnlock=source->Unlock(nullptr);
+  if (SUCCEEDED(result)) result=sourceUnlock;
+  return valid;
+}
+
+// Only an unclipped full-surface RGB565 fill may use this helper.
+inline bool FillLargeRGB565Surface(IDirectDrawSurface* destination, DWORD color, HRESULT& result) {
+  if (color>UINT16_MAX) return false;
+  DDSURFACEDESC output{};
+  output.dwSize=sizeof(output);
+  if (FAILED(destination->Lock(nullptr,&output,DDLOCK_WRITEONLY|DDLOCK_WAIT,nullptr))) return false;
+  const auto& p=output.ddpfPixelFormat;
+  const bool valid=p.dwFlags==DDPF_RGB && p.dwRGBBitCount==16 &&
+    p.dwRBitMask==0xf800 && p.dwGBitMask==0x7e0 && p.dwBBitMask==0x1f &&
+    output.dwWidth && output.dwHeight && output.lpSurface &&
+    reinterpret_cast<uintptr_t>(output.lpSurface)%alignof(uint16_t)==0 && output.lPitch%2==0 &&
+    output.lPitch>=int64_t(output.dwWidth)*2;
+  if (valid) {
+    for (DWORD y=0;y<output.dwHeight;++y)
+      std::fill_n(reinterpret_cast<uint16_t*>(static_cast<char*>(output.lpSurface)+size_t(y)*output.lPitch),output.dwWidth,uint16_t(color));
+  }
+  result=destination->Unlock(nullptr);
+  return valid;
+}
+}
diff --git a/src/ddraw/private_regions.h b/src/ddraw/private_regions.h
new file mode 100644
index 0000000..b2cfbc3
--- /dev/null
+++ b/src/ddraw/private_regions.h
@@ -0,0 +1,78 @@
+#pragma once
+#include <windows.h>
+#include <vector>
+
+namespace dxvk {
+inline std::vector<RECT> SubtractRegions(std::vector<RECT> pending, const std::vector<RECT>& covered) {
+  for (const RECT& known : covered) {
+    std::vector<RECT> next;
+    for (const RECT& part : pending) {
+      RECT intersection;
+      if (!IntersectRect(&intersection, &part, &known)) {
+        next.push_back(part);
+        continue;
+      }
+      const RECT pieces[] = {
+        {part.left,part.top,part.right,intersection.top},
+        {part.left,intersection.bottom,part.right,part.bottom},
+        {part.left,intersection.top,intersection.left,intersection.bottom},
+        {intersection.right,intersection.top,part.right,intersection.bottom}
+      };
+      for (const RECT& piece : pieces) if (!IsRectEmpty(&piece)) next.push_back(piece);
+    }
+    pending = std::move(next);
+    if (pending.empty()) break;
+  }
+  return pending;
+}
+
+inline void AddRegion(std::vector<RECT>& regions, const RECT& added) {
+  if (IsRectEmpty(&added)) return;
+  auto uncovered = SubtractRegions({added}, regions);
+  regions.insert(regions.end(), uncovered.begin(), uncovered.end());
+}
+
+inline void CoalesceCovered(std::vector<RECT>& dirty, const std::vector<RECT>& valid) {
+  if (dirty.size() < 2) return;
+  RECT bounds = dirty.front();
+  int64_t area = 0;
+  for (const RECT& part : dirty) UnionRect(&bounds, &bounds, &part);
+  for (const RECT& part : dirty) area += int64_t(part.right-part.left)*(part.bottom-part.top);
+  if (int64_t(bounds.right-bounds.left)*(bounds.bottom-bounds.top) > 2*area) return;
+  // Uploading an unchanged gap is safe only when its CPU pixels are current.
+  if (SubtractRegions({bounds}, valid).empty()) dirty = {bounds};
+}
+
+class BaselineDamage {
+  bool valid = false, gpuValid = false;
+  uint64_t identity = 0, version = 0;
+  std::vector<RECT> pending, visible;
+public:
+  void write(const RECT& rect, LONG height) {
+    if (!valid || IsRectEmpty(&rect)) return;
+    pending.resize((height+127)/128);
+    for (LONG row=rect.top/128;row<=(rect.bottom-1)/128;++row) {
+      RECT band{rect.left,std::max(rect.top,row*128),rect.right,std::min(rect.bottom,(row+1)*128)};
+      UnionRect(&pending[row],&pending[row],&band);
+    }
+  }
+  std::vector<RECT> copy(uint64_t sourceIdentity, uint64_t sourceVersion, const RECT& whole) {
+    const bool same = valid && identity==sourceIdentity && version==sourceVersion;
+    std::vector<RECT> damage;
+    if (!same || !gpuValid) damage.push_back(whole);
+    else for (const RECT& rect : visible) if (!IsRectEmpty(&rect)) damage.push_back(rect);
+    valid = true;
+    gpuValid = same && gpuValid;
+    identity = sourceIdentity;
+    version = sourceVersion;
+    pending.clear();
+    return damage;
+  }
+  void uploaded() {
+    if (!valid) return;
+    visible = pending;
+    gpuValid = true;
+  }
+  void invalidate() { valid = gpuValid = false; }
+};
+}
diff --git a/src/ddraw/private_stretch.h b/src/ddraw/private_stretch.h
new file mode 100644
index 0000000..1c9cebd
--- /dev/null
+++ b/src/ddraw/private_stretch.h
@@ -0,0 +1,69 @@
+#pragma once
+#include "private_native_copy.h"
+#include <type_traits>
+
+namespace dxvk {
+struct CPUStretchResult { bool handled=false; HRESULT result=DD_OK; bool written=false; };
+
+// A single fixed-point pixel-center rule for both enlarging and shrinking.
+// Native Windows stretching uses different rules for the two axes/scale
+// directions: scaling a 4x exact replica can change the original glyph shape.
+template<typename Surface>
+inline CPUStretchResult StretchRGB565Surface(Surface* destination,
+    Surface* source, RECT dst, RECT src, DWORD flags, const DDBLTFX* fx) {
+  if (!destination || !source || source==destination || !(flags&DDBLT_WAIT) ||
+      flags&~(DDBLT_WAIT|DDBLT_ASYNC|DDBLT_ROP|DDBLT_KEYSRC) ||
+      ((flags&DDBLT_ROP) ? (!fx || fx->dwSize!=sizeof(*fx) || fx->dwROP!=SRCCOPY) : fx!=nullptr)) return {};
+  if (src.left<0 || src.top<0 || src.right<=src.left || src.bottom<=src.top ||
+      dst.left<0 || dst.top<0 || dst.right<=dst.left || dst.bottom<=dst.top) return {};
+  const LONG sw=src.right-src.left,sh=src.bottom-src.top,dw=dst.right-dst.left,dh=dst.bottom-dst.top;
+  if (sw==dw && sh==dh) return {};
+  using Desc=std::conditional_t<std::is_same_v<Surface,IDirectDrawSurface4> ||
+    std::is_same_v<Surface,IDirectDrawSurface7>,DDSURFACEDESC2,DDSURFACEDESC>;
+  const auto unlock=[](Surface* surface,void* data,RECT* rect) {
+    if constexpr(std::is_same_v<Desc,DDSURFACEDESC>) return surface->Unlock(data);
+    else return surface->Unlock(rect);
+  };
+  Desc input{},output{}; input.dwSize=output.dwSize=sizeof(input);
+  if (FAILED(source->GetSurfaceDesc(&input)) || FAILED(destination->GetSurfaceDesc(&output))) return {};
+  const auto eligible=[](const Desc& d,RECT r) {
+    const auto& p=d.ddpfPixelFormat;
+    return p.dwFlags==DDPF_RGB && p.dwRGBBitCount==16 && p.dwRBitMask==0xf800 &&
+      p.dwGBitMask==0x7e0 && p.dwBBitMask==0x1f &&
+      r.left>=0 && r.top>=0 && uint64_t(r.right)<=d.dwWidth && uint64_t(r.bottom)<=d.dwHeight;
+  };
+  if (!eligible(input,src) || !eligible(output,dst)) return {};
+  DDCOLORKEY key{};
+  if ((flags&DDBLT_KEYSRC) && (FAILED(source->GetColorKey(DDCKEY_SRCBLT,&key)) ||
+      key.dwColorSpaceLowValue>key.dwColorSpaceHighValue || key.dwColorSpaceHighValue>0xffff)) return {};
+  HRESULT hr=source->Lock(&src,&input,DDLOCK_READONLY|DDLOCK_WAIT,nullptr);
+  if (FAILED(hr)) return {true,hr,false};
+  hr=destination->Lock(&dst,&output,DDLOCK_WRITEONLY|DDLOCK_WAIT,nullptr);
+  if (FAILED(hr)) { unlock(source,input.lpSurface,&src); return {true,hr,false}; }
+  input.dwWidth=sw; input.dwHeight=sh; output.dwWidth=dw; output.dwHeight=dh;
+  const bool valid=input.lpSurface && output.lpSurface &&
+    input.lPitch>=int64_t(sw)*2 && output.lPitch>=int64_t(dw)*2 &&
+    input.lPitch%2==0 && output.lPitch%2==0 &&
+    reinterpret_cast<uintptr_t>(input.lpSurface)%2==0 && reinterpret_cast<uintptr_t>(output.lpSurface)%2==0 &&
+    DisjointRGB565Storage(input,output);
+  if (valid) {
+    const uint64_t stepX=(uint64_t(sw)<<16)/dw,stepY=(uint64_t(sh)<<16)/dh;
+    uint64_t sampleY=stepY/2;
+    for (LONG y=0;y<dh;++y,sampleY+=stepY) {
+      const auto in=reinterpret_cast<const uint16_t*>(static_cast<const char*>(input.lpSurface)+(sampleY>>16)*input.lPitch);
+      auto out=reinterpret_cast<uint16_t*>(static_cast<char*>(output.lpSurface)+size_t(y)*output.lPitch);
+      uint64_t sampleX=stepX/2;
+      for (LONG x=0;x<dw;++x,sampleX+=stepX) {
+        const uint16_t pixel=in[sampleX>>16];
+        if (!(flags&DDBLT_KEYSRC) || pixel<key.dwColorSpaceLowValue || pixel>key.dwColorSpaceHighValue) out[x]=pixel;
+      }
+    }
+  }
+  hr=unlock(destination,output.lpSurface,&dst);
+  HRESULT sourceResult=unlock(source,input.lpSurface,&src);
+  if (SUCCEEDED(hr)) hr=sourceResult;
+  // Do not fall back after an unlock failure; any completed writes still
+  // belong to the CPU, even when the API reports that failure to the caller.
+  return {valid || FAILED(hr),hr,valid};
+}
+}
