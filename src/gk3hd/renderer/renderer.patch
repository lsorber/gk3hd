+  void DDrawCommonSurface::SnapshotCPUBacking() {
+    auto backing = GetCPUBacking();
+    if (!backing || IsDepthStencil()) return;
+    DDSURFACEDESC desc = {};
+    desc.dwSize = sizeof(desc);
+    if (FAILED(backing->Lock(nullptr, &desc, DDLOCK_READONLY | DDLOCK_WAIT, nullptr))) return;
+    const size_t pitch = size_t(m_rect.right) * desc.ddpfPixelFormat.dwRGBBitCount / 8;
+    m_cpuReferenceValid = false;
+    if (!desc.lpSurface || !pitch || desc.lPitch <= 0 || size_t(desc.lPitch) < pitch) {
+      backing->Unlock(nullptr);
+      return;
+    }
+    m_cpuReference.resize(pitch * m_rect.bottom);
+    for (LONG y = 0; y < m_rect.bottom; ++y)
+      memcpy(m_cpuReference.data() + y * pitch, static_cast<uint8_t*>(desc.lpSurface) + y * desc.lPitch, pitch);
+    m_cpuReferenceValid = SUCCEEDED(backing->Unlock(nullptr));
+  }
