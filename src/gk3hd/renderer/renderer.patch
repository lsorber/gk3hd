+  bool DDrawCommonSurface::TryGPUCopy(DDrawCommonSurface* source, RECT* destRect, RECT* srcRect, DWORD flags, DDBLTFX* fx) {
+    if (PreferCPUThisFrame() || (source && source->PreferCPUThisFrame())) return false;
+    if (source && !IsRenderTarget() && !source->IsRenderTarget() && !source->IsD3D9SurfaceDirty())
+      return false;
+    if (!m_commonIntf->GetOptions()->cpuRenderTargetBacking || !source || source == this ||
+        flags & ~(DDBLT_ROP | DDBLT_WAIT | DDBLT_ASYNC) || ((flags & DDBLT_ROP) && (!fx || fx->dwROP != SRCCOPY)) ||
+        m_clipper != nullptr ||
+        IsDepthStencil() || source->IsDepthStencil() ||
+        IsPrimarySurface() || source->IsPrimarySurface() || m_format9 != source->m_format9)
+      return false;
+    auto dev = GetRefreshedD3D9Device();
+    if (!dev || dev != source->GetRefreshedD3D9Device() || m_commonD3DDevice->IsInScene())
+      return false;
+    if (IsBindableAsTexture() || source->IsBindableAsTexture())
+      return false;
+    RECT dst = destRect ? *destRect : m_rect;
+    RECT src = srcRect ? *srcRect : source->m_rect;
+    if (dst.right-dst.left != src.right-src.left || dst.bottom-dst.top != src.bottom-src.top ||
+        dst.left < 0 || dst.top < 0 || dst.right > m_rect.right || dst.bottom > m_rect.bottom ||
+        src.left < 0 || src.top < 0 || src.right > source->m_rect.right || src.bottom > source->m_rect.bottom)
+      return false;
+    auto hr = source->InitializeOrUploadD3D9();
+    if (FAILED(hr)) return false;
+    hr = InitializeOrUploadD3D9();
+    if (FAILED(hr)) return false;
+    hr = dev->StretchRect(source->m_surface9.ptr(), &src, m_surface9.ptr(), &dst, d3d9::D3DTEXF_POINT);
+    if (FAILED(hr)) return false;
+    DirtyD3D9Surface();
+    UnDirtyDDrawSurface();
+    return true;
+  }
