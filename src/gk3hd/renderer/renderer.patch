+  HRESULT DDrawCommonSurface::UploadCPURegions() {
+    auto backing = GetCPUBacking();
+    if (!backing || !IsRenderTarget() || !IsInitialized() || m_cpuDirtyRegions.empty() ||
+        m_commonD3DDevice->GetMultiSampleType() != d3d9::D3DMULTISAMPLE_NONE) return DDERR_UNSUPPORTED;
+    auto dev = GetRefreshedD3D9Device();
+    if (!dev || !IsInitialized()) return DDERR_SURFACELOST;
+    HRESULT hr = DD_OK;
+    if (m_cpuUpload == nullptr) {
+      hr = dev->CreateOffscreenPlainSurface(m_rect.right,m_rect.bottom,m_format9,
+        d3d9::D3DPOOL_SYSTEMMEM,&m_cpuUpload,nullptr);
+      if (FAILED(hr)) return hr;
+    }
+    DDSURFACEDESC desc = {};
+    desc.dwSize = sizeof(desc);
+    hr = backing->Lock(nullptr,&desc,DDLOCK_READONLY | DDLOCK_WAIT,nullptr);
+    if (FAILED(hr)) return hr;
+    const size_t pixelBytes = desc.ddpfPixelFormat.dwRGBBitCount/8;
+    const size_t rowBytes = size_t(m_rect.right)*pixelBytes;
+    const size_t fullBytes = rowBytes*m_rect.bottom;
+    const auto fail = [&](HRESULT result) {
+      m_cpuReferenceValid = false;
+      backing->Unlock(nullptr);
+      return result;
+    };
+    if (!desc.lpSurface || !pixelBytes || desc.lPitch <= 0 || size_t(desc.lPitch)<rowBytes)
+      return fail(DDERR_INVALIDPARAMS);
+    if (m_cpuReference.size()!=fullBytes) m_cpuReferenceValid=false;
+    for (RECT region : m_cpuDirtyRegions) {
+      if (m_cpuReferenceValid) {
+        RECT changed{};
+        for (LONG y=region.top;y<region.bottom;++y) {
+          if (memcmp(m_cpuReference.data()+y*rowBytes+region.left*pixelBytes,
+              static_cast<uint8_t*>(desc.lpSurface)+y*desc.lPitch+region.left*pixelBytes,
+              (region.right-region.left)*pixelBytes)) {
+            RECT row{region.left,y,region.right,y+1};
+            UnionRect(&changed,&changed,&row);
+          }
+        }
+        region=changed;
+      }
+      if (IsRectEmpty(&region)) continue;
+      d3d9::D3DLOCKED_RECT mapped;
+      hr = m_cpuUpload->LockRect(&mapped,&region,0);
+      if (FAILED(hr)) return fail(hr);
+      if (!mapped.pBits || mapped.Pitch <= 0 || size_t(mapped.Pitch)<size_t(region.right-region.left)*pixelBytes) {
+        m_cpuUpload->UnlockRect();
+        return fail(DDERR_INVALIDPARAMS);
+      }
+      for (LONG y=region.top;y<region.bottom;++y)
+        memcpy(static_cast<uint8_t*>(mapped.pBits)+(y-region.top)*mapped.Pitch,
+          static_cast<uint8_t*>(desc.lpSurface)+y*desc.lPitch+region.left*pixelBytes,
+          (region.right-region.left)*pixelBytes);
+      hr = m_cpuUpload->UnlockRect();
+      if (FAILED(hr)) return fail(hr);
+      POINT origin = {region.left,region.top};
+      hr = dev->UpdateSurface(m_cpuUpload.ptr(),&region,m_surface9.ptr(),&origin);
+      if (FAILED(hr)) return fail(hr);
+      if (m_cpuReferenceValid) {
+        for (LONG y=region.top;y<region.bottom;++y)
+          memcpy(m_cpuReference.data()+y*rowBytes+region.left*pixelBytes,
+            static_cast<uint8_t*>(desc.lpSurface)+y*desc.lPitch+region.left*pixelBytes,
+            (region.right-region.left)*pixelBytes);
+      }
+    }
+    if (!m_cpuReferenceValid && SubtractRegions({m_rect},m_cpuValidRegions).empty()) {
+      m_cpuReference.resize(fullBytes);
+      for (LONG y=0;y<m_rect.bottom;++y)
+        memcpy(m_cpuReference.data()+y*rowBytes,static_cast<uint8_t*>(desc.lpSurface)+y*desc.lPitch,rowBytes);
+      m_cpuReferenceValid=true;
+    }
+    hr = backing->Unlock(nullptr);
+    if (FAILED(hr)) {
+      m_cpuReferenceValid = false;
+      return hr;
+    }
+    UnDirtyDDrawSurface();
+    return DD_OK;
+  }
