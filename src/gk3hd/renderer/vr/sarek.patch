+  struct XrTransport final : gk3hd::vr::FrameTransport {
+    D3D9DeviceEx* device;
+    const gk3hd::vr::PanelGeometry* keyboard = nullptr;
+    const gk3hd::vr::PanelGeometry* subtitle = nullptr;
+    // The auxiliary quad is either a modal keyboard or display-only labels.
+    bool auxiliaryTransparent = false;
+    explicit XrTransport(D3D9DeviceEx* value) : device(value) { }
+    bool begin(gk3hd::vr::FrameViews& frame) override {
+      auto gpu = device->GetDXVKDevice();
+      if (!gpu->beginXrFrame()) return false;
+      const auto& runtime = gpu->instance()->xr()->runtime();
+      frame.input = runtime.input();
+      for (unsigned eye = 0; eye < 2; ++eye) {
+        const auto& view = runtime.views()[eye];
+        const auto& config = runtime.configuration()[eye];
+        frame.eyes[eye] = {config.recommendedImageRectWidth, config.recommendedImageRectHeight,
+          {view.pose.orientation.x, view.pose.orientation.y, view.pose.orientation.z, view.pose.orientation.w},
+          {view.pose.position.x, view.pose.position.y, view.pose.position.z},
+          {view.fov.angleLeft, view.fov.angleRight, view.fov.angleUp, view.fov.angleDown}};
+      }
+      return true;
+    }
+    void end(bool world, const gk3hd::vr::PanelGeometry* panel) override {
+      gk3hd::vr::PanelLayer layer{};
+      if (panel) {
+        layer = {{{panel->orientation[0], panel->orientation[1], panel->orientation[2], panel->orientation[3]},
+                   {panel->position[0], panel->position[1], panel->position[2]}},
+                 {panel->size[0], panel->size[1]}, device->XrPanel().transparent()};
+      }
+      gk3hd::vr::PanelLayer keys{};
+      if (keyboard) keys = {{{keyboard->orientation[0], keyboard->orientation[1], keyboard->orientation[2], keyboard->orientation[3]},
+                           {keyboard->position[0], keyboard->position[1], keyboard->position[2]}},
+                          {keyboard->size[0], keyboard->size[1]}, auxiliaryTransparent};
+      gk3hd::vr::PanelLayer captions{};
+      if (subtitle) captions = {{{subtitle->orientation[0], subtitle->orientation[1], subtitle->orientation[2], subtitle->orientation[3]},
+                               {subtitle->position[0], subtitle->position[1], subtitle->position[2]}},
+                              {subtitle->size[0], subtitle->size[1]}, true};
+      device->GetDXVKDevice()->endXrFrame(world, panel ? &layer : nullptr, keyboard ? &keys : nullptr,
+                                        subtitle ? &captions : nullptr);
+    }
+  };
