+  bool DxvkDevice::beginXrFrame() {
+    stopLoadingXrFrames();
+    auto* host = m_instance->xr();
+    if (!host || m_xrFrame) throw DxvkError("GK3HD: invalid XR frame begin");
+    auto& runtime = host->runtime();
+    lockSubmission();
+    try {
+      if (!runtime.readyForFrame()) {
+        unlockSubmission();
+        return false;
+      }
+    } catch (...) {
+      unlockSubmission();
+      throw;
+    }
+    unlockSubmission();
+    // Keep the submission thread free to feed the GPU during xrWaitFrame.
+    // Only queue-accessing begin/failure cleanup borrow its Vulkan queue.
+    if (!runtime.beginFrame([this] { lockSubmission(); }, [this] { unlockSubmission(); })) {
+      lockSubmission();
+      try { runtime.endFrame(false); }
+      catch (...) { unlockSubmission(); throw; }
+      unlockSubmission();
+      return false;
+    }
+    m_xrFrame = true;
+    m_xrWritten = {};
+    return true;
+  }
