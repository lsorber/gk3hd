+#version 450
+layout(location=0) in vec3 position;
+layout(location=1) in vec2 uv;
+struct Material { vec4 uvTransform;vec4 color;uvec4 texturesFlags;vec4 keyLow;vec4 keyHigh; };
+layout(std430,set=0,binding=0) readonly buffer Materials { Material values[]; } materials;
+layout(push_constant,std430,row_major) uniform Views { mat4 eye; } views;
+layout(location=0) out vec2 baseUv;
+layout(location=1) out vec2 lightUv;
+layout(location=2) flat out uint surface;
+layout(location=3) flat out vec4 materialColor;
+layout(location=4) flat out uvec4 materialTextures;
+layout(location=5) flat out vec4 materialKeyLow;
+layout(location=6) flat out vec4 materialKeyHigh;
+out gl_PerVertex { vec4 gl_Position; };
+void main() {
+  surface=uint(gl_InstanceIndex)>>1u;
+  Material material=materials.values[surface];
+  materialColor=material.color;materialTextures=material.texturesFlags;
+  materialKeyLow=material.keyLow;materialKeyHigh=material.keyHigh;
+  baseUv=uv;lightUv=(uv+material.uvTransform.xy)*material.uvTransform.zw;
+  gl_Position=vec4(position,1.0)*views.eye;
+}
