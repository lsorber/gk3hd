+  void D3D9DeviceEx::BindXrEye(unsigned eye, uint32_t width, uint32_t height) {
+    if (eye >= 2 || !width || !height) throw DxvkError("GK3HD: invalid XR eye target");
+    auto check = [](HRESULT result) {
+      if (FAILED(result)) throw DxvkError("GK3HD: XR eye target allocation/bind failed");
+    };
+    Com<IDirect3DSurface9> source, depth;
+    check(GetRenderTarget(0, &source));
+    D3DSURFACE_DESC colorDesc{}, depthDesc{};
+    check(source->GetDesc(&colorDesc));
+    const auto hasDepth = GetDepthStencilSurface(&depth);
+    if (FAILED(hasDepth) && hasDepth != D3DERR_NOTFOUND)
+      check(hasDepth);
+    if (depth != nullptr) check(depth->GetDesc(&depthDesc));
+    const D3DFORMAT depthFormat = depth != nullptr ? depthDesc.Format : D3DFMT_D16;
+    const VkExtent2D extent{width, height};
+    auto& target = m_xrEyeTargets[eye];
+    if (target.color == nullptr || target.extent != extent ||
+        target.colorFormat != colorDesc.Format || target.depthFormat != depthFormat) {
+      Com<IDirect3DSurface9> colorTarget, depthTarget;
+      check(CreateRenderTarget(width, height, colorDesc.Format, D3DMULTISAMPLE_NONE,
+                               0, FALSE, &colorTarget, nullptr));
+      check(CreateDepthStencilSurface(width, height, depthFormat, D3DMULTISAMPLE_NONE,
+                                     0, FALSE, &depthTarget, nullptr));
+      // Internal references cannot retain their owning device in a cycle.
+      target.color = static_cast<D3D9Surface*>(colorTarget.ptr());
+      target.depth = static_cast<D3D9Surface*>(depthTarget.ptr());
+      target.extent = extent;
+      target.colorFormat = colorDesc.Format; target.depthFormat = depthFormat;
+    }
+    check(SetDepthStencilSurface(nullptr));
+    check(SetRenderTarget(0, target.color.ptr()));
+    check(SetDepthStencilSurface(target.depth.ptr()));
+    D3DVIEWPORT9 viewport{0, 0, width, height, 0.f, 1.f};
+    check(SetViewport(&viewport));
+    check(SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE));
+  }
