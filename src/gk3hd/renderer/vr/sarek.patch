+namespace dxvk {
+// Retained geometry, per-transaction material/view/draw
+// buffers, and tracked managed textures. No geometry/pipeline rebuild per draw.
+struct GkWorldVertex { float xyz[3],uv[2]; };
+struct GkWorldMaterial { float uv[4],color[4];uint32_t texturesFlags[4];float keyLow[4],keyHigh[4]; };
+struct GkWorldDraw { uint32_t count,instances,first;int32_t offset;uint32_t firstInstance; };
+static_assert(sizeof(GkWorldVertex)==20&&sizeof(GkWorldMaterial)==80&&sizeof(GkWorldDraw)==20);
+inline Rc<DxvkBuffer> gkWorldBuffer(const Rc<DxvkDevice>& device,const void* data,size_t bytes,
+ VkBufferUsageFlags usage,VkPipelineStageFlags stages,VkAccessFlags access) {
+ if(!bytes||bytes>64u*1024u*1024u||!data)throw DxvkError("world buffer outside bounded input");
+ DxvkBufferCreateInfo info={bytes,usage,stages,access};
+ auto buffer=device->createBuffer(info,VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT|VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
