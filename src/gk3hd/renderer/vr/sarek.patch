+  HRESULT D3D9XrText(void* device, void* request) {
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    if (!modern || !request) return E_POINTER;
+    if (!modern->GetDXVKDevice()->instance()->xr()) return E_NOTIMPL;
+    try {
+      modern->XrText().configure(*static_cast<gk3hd::vr::TextFrame*>(request));
+      return S_OK;
+    } catch (const std::exception&) { return E_INVALIDARG; }
+  }
+
+  HRESULT D3D9XrPanel(void* device, uint32_t operation, void* request, const void* overlay,
+                     const void* displayOverlay, const void* subtitleOverlay) {
+    if (operation > uint32_t(gk3hd::vr::PanelOperation::Loading)) return E_INVALIDARG;
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    if (!modern || !modern->GetDXVKDevice()->instance()->xr()) return E_NOTIMPL;
+    auto* frame = static_cast<gk3hd::vr::PanelFrame*>(request);
+    XrTransport transport{modern};
+    try {
+      if (modern->GetDXVKDevice()->loadingXrFrames() &&
+          (operation == uint32_t(gk3hd::vr::PanelOperation::Loading) ||
+           operation == uint32_t(gk3hd::vr::PanelOperation::Close))) {
+        // Nested native loading boundaries and empty UI finalizers do not
+        // take frame ownership away from the helper before a real draw.
+        return S_OK;
+      }
+      modern->GetDXVKDevice()->stopLoadingXrFrames();
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::Loading)) {
+        modern->XrPanel().close(); modern->XrText().close();
+        const bool submitted = modern->XrFrames().blank(transport);
+        modern->GetDXVKDevice()->startLoadingXrFrames();
+        return submitted ? S_OK : S_FALSE;
+      }
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::Blank)) {
+        modern->XrPanel().close();
+        modern->XrText().close();
+        return modern->XrFrames().blank(transport) ? S_OK : S_FALSE;
+      }
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::Close)) {
+        modern->XrPanel().close();
+        modern->XrText().close();
+        // Finalize a deferred world even if there is no interface this frame.
+        modern->XrFrames().finish(transport);
+        return S_OK;
+      }
+      if (!frame) {
+        modern->XrText().close();
+        modern->XrFrames().cancel(transport);
+        return E_POINTER;
+      }
+      gk3hd::vr::PanelState::validate(*frame);
+      frame->geometry = {}; frame->input = {}; frame->pointer = {};
+      const bool isolated = operation == uint32_t(gk3hd::vr::PanelOperation::Caption) ||
+                            operation == uint32_t(gk3hd::vr::PanelOperation::Overlay);
+      const bool modalSubtitles = operation == uint32_t(gk3hd::vr::PanelOperation::ModalSubtitles);
+      if (isolated != bool(frame->flags & gk3hd::vr::PanelTransparent) || (isolated && !overlay))
+        throw DxvkError("GK3HD: inconsistent isolated interface request");
+      if (displayOverlay && (!isolated || !(frame->flags & gk3hd::vr::PanelReadableMenu)))
+        throw DxvkError("GK3HD: display-only companion outside readable menu frame");
+      if ((subtitleOverlay && !isolated && !modalSubtitles) || (modalSubtitles && !subtitleOverlay))
+        throw DxvkError("GK3HD: subtitle without a valid world or native screen");
+      if (isolated && !modern->XrFrames().worldReady()) {
+        modern->XrPanel().close(); modern->XrText().close(); modern->XrFrames().cancel(transport);
+        return S_FALSE;
+      }
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::World)) {
+        modern->XrPanel().close();
+        modern->XrText().close();
+        if (!modern->XrFrames().worldReady()) {
+          modern->XrFrames().cancel(transport);
+          return S_FALSE;
+        }
+        const auto* sampled = modern->XrFrames().begin(transport);
+        if (!sampled) throw DxvkError("GK3HD: ready XR world has no input snapshot");
+        gk3hd::vr::PanelState::world(*frame, *sampled);
+        modern->XrFrames().finish(transport);
+        return S_OK;
+      }
+      const auto* views = modern->XrFrames().begin(transport);
+      if (!views) {
+        modern->XrText().close();
+        modern->XrFrames().finish(transport);
+        return S_FALSE;
+      }
+      modern->XrPanel().prepare(*frame, *views, isolated ? static_cast<const gk3hd::vr::OverlayImage*>(overlay) : nullptr);
+      if (isolated) modern->WriteXrOverlay(*static_cast<const gk3hd::vr::OverlayImage*>(overlay), 2, &frame->pointer);
+      else modern->WriteXrPanel(*frame, static_cast<const gk3hd::vr::OverlayImage*>(subtitleOverlay));
+      gk3hd::vr::KeyboardFrame keys{};
+      gk3hd::vr::PanelGeometry labels{};
+      gk3hd::vr::PanelGeometry captions{};
+      if (isolated) {
+        modern->XrText().close();
+        if (displayOverlay) {
+          modern->WriteXrOverlay(*static_cast<const gk3hd::vr::OverlayImage*>(displayOverlay), 3);
+          labels = modern->XrPanel().canvasGeometry();
+          transport.keyboard = &labels;
+          transport.auxiliaryTransparent = true;
+        }
+      }
+      else {
+        keys = modern->XrText().prepare(*frame);
+        if (keys.visible) {
+          modern->WriteXrOverlay(modern->XrText().image(keys), 3);
+          transport.keyboard = &keys.geometry;
+        }
+      }
+      if (subtitleOverlay) {
+        modern->WriteXrOverlay(*static_cast<const gk3hd::vr::OverlayImage*>(subtitleOverlay), 4);
+        captions = modern->XrPanel().subtitleGeometry(frame->canvasWidth, frame->canvasHeight);
+        transport.subtitle = &captions;
+      }
+      modern->XrFrames().finish(transport, &frame->geometry);
+      return S_OK;
+    } catch (const DxvkError& error) {
+      Logger::err(str::format("GK3HD: XR panel bridge: ", error.message()));
+    } catch (const std::exception& error) {
+      Logger::err(str::format("GK3HD: XR panel bridge: ", error.what()));
+    } catch (...) {
+      Logger::err("GK3HD: unknown XR panel bridge failure");
+    }
+    if (frame) { frame->geometry = {}; frame->input = {}; frame->pointer = {}; }
+    modern->XrText().close();
+    try { modern->XrFrames().cancel(transport); } catch (...) { }
+    return E_FAIL;
+  }
