+  void D3D9DeviceEx::WriteXrOverlay(const gk3hd::vr::OverlayImage& overlay, unsigned target,
+                                  const gk3hd::vr::PanelPointer* pointer) {
+    D3D9DeviceLock lock = LockDevice();
+    const auto crop = gk3hd::vr::overlayUploadRegion(overlay);
+    VkExtent2D capacity{gk3hd::vr::overlayTextureExtent(crop.width(), overlay.width),
+                        gk3hd::vr::overlayTextureExtent(crop.height(), overlay.height)};
+    const VkExtent2D canvas{overlay.width, overlay.height};
+    if (canvas == m_xrOverlayCanvas) {
+      capacity.width = std::max(capacity.width, m_xrOverlayExtent.width);
+      capacity.height = std::max(capacity.height, m_xrOverlayExtent.height);
+    }
+    if (m_xrOverlayTexture == nullptr || m_xrOverlayExtent != capacity || m_xrOverlayCanvas != canvas) {
+      Com<IDirect3DTexture9> texture;
+      if (FAILED(CreateTexture(capacity.width, capacity.height, 1, D3DUSAGE_DYNAMIC,
+                              D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &texture, nullptr)))
+        throw DxvkError("GK3HD: cannot allocate transparent interface texture");
+      // Private ownership must not retain our parent device through a public
+      // texture reference, otherwise device/session recreation leaks a cycle.
+      m_xrOverlayTexture = static_cast<D3D9Texture2D*>(texture.ptr());
+      m_xrOverlayExtent = capacity; m_xrOverlayCanvas = canvas;
+    }
+    auto* texture = m_xrOverlayTexture->GetCommonTexture();
+    D3DLOCKED_BOX locked;
+    if (FAILED(LockImage(texture, 0, 0, &locked, nullptr, D3DLOCK_DISCARD)))
+      throw DxvkError("GK3HD: cannot upload transparent interface texture");
+    for (uint32_t y = 0; y < crop.height(); ++y)
+      std::memcpy(static_cast<uint8_t*>(locked.pBits) + size_t(y)*locked.RowPitch,
+                  overlay.pixels.data() + size_t(y+crop.top)*overlay.width + crop.left, size_t(crop.width())*4);
+    // Lock the full private texture with DISCARD to rename its staging buffer
+    // without waiting for old GPU readers. Only initialized crop rows are dirty;
+    // unused capacity is neither uploaded nor sampled by the exact-size blit.
+    const D3DBOX uploaded{0, 0, crop.width(), crop.height(), 0, 1};
+    texture->ClearDirtyBoxes(); texture->AddDirtyBox(&uploaded, 0);
+    if (FAILED(UnlockImage(texture, 0, 0))) throw DxvkError("GK3HD: interface upload failed");
+    const auto image = texture->GetImage();
+    EmitCs([image](DxvkContext* ctx) {
+      ctx->transformImage(image, image->getAvailableSubresources(), image->info().layout, image->info().layout);
+    });
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+    if (target == 4) m_dxvkDevice->configureXrSubtitle(overlay.width, overlay.height);
+    else if (target == 3) m_dxvkDevice->configureXrKeyboard(overlay.width, overlay.height);
+    else if (target == 2) m_dxvkDevice->configureXrPanel(overlay.width, overlay.height);
+    else throw DxvkError("GK3HD: invalid overlay target");
+    const VkRect2D destination{{int32_t(crop.left), int32_t(crop.top)}, {crop.width(), crop.height()}};
+    m_dxvkDevice->writeXrEye(target, image, m_implicitSwapchain->GetXrGammaBlitter(true), true, destination, 1.f, {}, pointer);
+  }
