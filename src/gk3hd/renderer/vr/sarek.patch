+          check(device->SetTextureStageState(0, D3DTSS_COLORARG1, D3DTA_DIFFUSE));
+          check(device->SetTextureStageState(0, D3DTSS_ALPHAOP, D3DTOP_SELECTARG1));
+          check(device->SetTextureStageState(0, D3DTSS_ALPHAARG1, D3DTA_DIFFUSE));
+          check(device->SetTextureStageState(1, D3DTSS_COLOROP, D3DTOP_DISABLE));
+          check(device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE));
+          check(device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE));
+          check(device->SetRenderState(D3DRS_ZFUNC, D3DCMP_LESSEQUAL));
+          check(device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE));
+          check(device->SetRenderState(D3DRS_FILLMODE, D3DFILL_SOLID));
+          check(device->SetRenderState(D3DRS_LIGHTING, FALSE));
+          check(device->SetRenderState(D3DRS_FOGENABLE, FALSE));
+          check(device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE));
+          check(device->SetRenderState(D3DRS_ALPHABLENDENABLE, TRUE));
+          check(device->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA));
+          check(device->SetRenderState(D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA));
+          check(device->SetRenderState(D3DRS_BLENDOP, D3DBLENDOP_ADD));
+          check(device->SetRenderState(D3DRS_STENCILENABLE, FALSE));
+          check(device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE));
+          check(device->SetRenderState(D3DRS_SRGBWRITEENABLE, FALSE));
+          check(device->SetRenderState(D3DRS_DEPTHBIAS, 0));
+          check(device->SetRenderState(D3DRS_SLOPESCALEDEPTHBIAS, 0));
+          check(device->SetRenderState(D3DRS_COLORWRITEENABLE, 15));
+          check(device->SetRenderState(D3DRS_MULTISAMPLEMASK, 0xffffffffu));
