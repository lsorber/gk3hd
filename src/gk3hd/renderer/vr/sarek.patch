+  void DxvkDevice::writeXrEye(unsigned eye, const Rc<DxvkImage>& source,
+                             const Rc<DxvkSwapchainBlitter>& gamma, bool premultiplied, VkRect2D crop,
+                             float visibility, VkRect2D matte, const gk3hd::vr::PanelPointer* pointer) {
+    if (!std::isfinite(visibility) || visibility < 0.f || visibility > 1.f ||
+        (visibility != 1.f && (eye >= 2 || !gamma)))
+      throw DxvkError("GK3HD: invalid XR world visibility");
+    if (!m_xrFrame || eye >= 5 || m_xrWritten[eye] || m_xrImages[eye].empty() || !source ||
+        source->info().type != VK_IMAGE_TYPE_2D ||
+        source->info().sampleCount != VK_SAMPLE_COUNT_1_BIT ||
+        (source->info().format != VK_FORMAT_R5G6B5_UNORM_PACK16 &&
+         source->info().format != VK_FORMAT_B5G6R5_UNORM_PACK16 &&
+         source->info().format != VK_FORMAT_R8G8B8A8_UNORM &&
+         source->info().format != VK_FORMAT_B8G8R8A8_UNORM) ||
+        !(source->info().usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+      throw DxvkError("GK3HD: invalid XR eye source or transaction");
+    auto* host = m_instance->xr();
+    if (!host) throw DxvkError("GK3HD: XR eye write without a host");
+    const bool cropped = crop.extent.width || crop.extent.height;
+    const auto canvas = eye == 4 ? m_xrSubtitleExtent : eye == 3 ? m_xrKeyboardExtent : m_xrPanelExtent;
+    if (cropped && (eye < 2 || !gamma || !premultiplied || !crop.extent.width || !crop.extent.height ||
+        crop.offset.x < 0 || crop.offset.y < 0 ||
+        uint64_t(crop.offset.x)+crop.extent.width > canvas.width ||
+        uint64_t(crop.offset.y)+crop.extent.height > canvas.height ||
+        crop.extent.width > source->info().extent.width || crop.extent.height > source->info().extent.height))
+      throw DxvkError("GK3HD: invalid XR overlay upload rectangle");
+    const bool matted = matte.extent.width || matte.extent.height;
+    if (matted && (eye != 2 || premultiplied || cropped || matte.offset.x < 0 || matte.offset.y < 0 ||
+        !matte.extent.width || !matte.extent.height ||
+        uint64_t(matte.offset.x)+matte.extent.width > canvas.width ||
+        uint64_t(matte.offset.y)+matte.extent.height > canvas.height))
+      throw DxvkError("GK3HD: invalid XR modal subtitle matte");
+
+    // The caller flushed and synchronized the D3D9 command stream, not the GPU.
+    // Submit the transfer on the same queue after those scene commands. No CPU
+    // readback, device-idle wait, desktop presentation, or game update here.
+    lockSubmission();
+    uint32_t index;
+    try { index = eye == 4 ? host->runtime().acquireSubtitle() : eye == 3 ? host->runtime().acquireKeyboard() :
+                  eye == 2 ? host->runtime().acquirePanel() : host->runtime().acquireEye(eye); }
+    catch (...) { unlockSubmission(); throw; }
+    unlockSubmission();
+    try {
+      const auto destination = xrImage(eye, index);
+      auto context = createContext();
+      context->beginRecording(createCommandList());
+      if (!m_xrScratch[eye]) {
+        auto info = destination->info();
+        info.format = host->format() == VK_FORMAT_R8G8B8A8_SRGB
+          ? VK_FORMAT_R8G8B8A8_UNORM : VK_FORMAT_B8G8R8A8_UNORM;
+        info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                     VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+        info.stages = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+        info.access = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT |
+                      VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        info.layout = VK_IMAGE_LAYOUT_GENERAL;
+        info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        m_xrScratch[eye] = createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        context->initImage(m_xrScratch[eye], {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}, VK_IMAGE_LAYOUT_UNDEFINED);
+      }
+      const VkImageSubresourceLayers layer{VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+      VkImageBlit region{};
+      region.srcSubresource = region.dstSubresource = layer;
+      region.srcOffsets[1] = {int32_t(source->info().extent.width), int32_t(source->info().extent.height), 1};
+      region.dstOffsets[1] = {int32_t(destination->info().extent.width), int32_t(destination->info().extent.height), 1};
+      const VkComponentMapping identity{VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY,
+        VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY};
+      // Numeric conversion/scaling in UNORM preserves GK3's encoded RGB565
+      // values. Compatible UNORM -> sRGB copy preserves those bytes, avoiding
+      // an unwanted extra sRGB encode from a direct image blit.
+      if (gamma) {
+        DxvkImageViewCreateInfo view{};
+        view.type = VK_IMAGE_VIEW_TYPE_2D;
+        view.format = m_xrScratch[eye]->info().format;
+        view.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+        view.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+        view.numLevels = view.numLayers = 1;
+        const auto dst = createImageView(m_xrScratch[eye], view);
+        view.format = source->info().format;
+        view.usage = VK_IMAGE_USAGE_SAMPLED_BIT;
+        const auto src = createImageView(source, view);
+        // Use the exact accepted desktop ramp and shader. UNORM output keeps
+        // encoded game colours; alpha-aware mode protects transparent captions.
+        // The copy shader samples the crop 1:1 at its original canvas origin.
+        // The existing blitter clears everything outside a partial destination
+        // to transparent zero, including pixels occupied by an earlier batch.
+        const VkRect2D uploaded{{0, 0}, crop.extent};
+        gamma->presentImage(context.ptr(), dst, cropped ? crop : VkRect2D{},
+                            src, cropped ? uploaded : VkRect2D{}, premultiplied, visibility, true);
+      } else {
+        context->blitImage(m_xrScratch[eye], identity, source, identity, region, VK_FILTER_LINEAR);
+      }
+      if (matted) {
+        DxvkImageViewCreateInfo view{};
+        view.type = VK_IMAGE_VIEW_TYPE_2D; view.format = m_xrScratch[eye]->info().format;
+        view.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT; view.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+        view.numLevels = view.numLayers = 1;
+        VkClearValue black{}; black.color.float32[3] = 1.f;
+        // Replace only baked glyphs in our private copy. The game page, native
+        // frame/camera state and all pixels outside the supplied region remain
+        // untouched. The readable subtitle is a separate noninteractive layer.
+        context->clearImageView(createImageView(m_xrScratch[eye], view),
+          {matte.offset.x, matte.offset.y, 0}, {matte.extent.width, matte.extent.height, 1},
+          VK_IMAGE_ASPECT_COLOR_BIT, black);
+      }
+      // Cursor is drawn after the private copy/matte, never into the native
+      // framebuffer. The input owner uses precisely this logical point.
+      for (const auto& rect : gk3hd::vr::panelCursor(pointer,
+             destination->info().extent.width, destination->info().extent.height)) {
+        DxvkImageViewCreateInfo view{};
+        view.type = VK_IMAGE_VIEW_TYPE_2D; view.format = m_xrScratch[eye]->info().format;
+        view.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT; view.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+        view.numLevels = view.numLayers = 1;
+        VkClearValue color{}; color.color.float32[3] = 1.f;
+        if (rect.white) color.color.float32[0] = color.color.float32[1] = color.color.float32[2] = 1.f;
+        context->clearImageView(createImageView(m_xrScratch[eye], view),
+          {rect.left,rect.top,0}, {uint32_t(rect.right-rect.left),uint32_t(rect.bottom-rect.top),1},
+          VK_IMAGE_ASPECT_COLOR_BIT,color);
+      }
+      context->copyImage(destination, layer, {}, m_xrScratch[eye], layer, {}, destination->info().extent);
+      submitCommandList(context->endRecording(), VK_NULL_HANDLE, VK_NULL_HANDLE);
+      // Drain queue *submissions*, not GPU execution. OpenXR consumes work in
+      // the bound queue's order. The context restores COLOR_ATTACHMENT_OPTIMAL.
+      lockSubmission();
+      try {
+        if (eye == 4) host->runtime().releaseSubtitle();
+        else if (eye == 3) host->runtime().releaseKeyboard();
+        else if (eye == 2) host->runtime().releasePanel(); else host->runtime().releaseEye(eye);
+      }
+      catch (...) { unlockSubmission(); throw; }
+      unlockSubmission();
+      m_xrWritten[eye] = true;
+    } catch (...) {
+      // A partially failed image write cannot be retried with unknown ownership.
+      // Drain only on this exceptional path, remove borrowed wrappers, then
+      // close the session. The caller must recreate its graphics device.
+      waitForIdle();
+      for (auto& image : m_xrScratch) image = nullptr;
+      for (auto& images : m_xrImages) images.clear();
+      lockSubmission();
+      host->stopDevice();
+      unlockSubmission();
+      m_xrFrame = false;
+      throw;
+    }
+  }
+
+  void DxvkDevice::endXrFrame(bool rendered, const gk3hd::vr::PanelLayer* panel, const gk3hd::vr::PanelLayer* keyboard,
+                            const gk3hd::vr::PanelLayer* subtitle) {
+    if (!m_xrFrame || (rendered && (!m_xrWritten[0] || !m_xrWritten[1])) ||
+        (panel && !m_xrWritten[2]) || (keyboard && (!panel || !m_xrWritten[3])) ||
+        (subtitle && ((!rendered && !panel) || !m_xrWritten[4])))
+      throw DxvkError("GK3HD: XR submission requires two complete eyes");
+    lockSubmission();
+    try { m_instance->xr()->runtime().endFrame(rendered, panel, keyboard, subtitle); }
+    catch (...) { m_xrFrame = false; unlockSubmission(); throw; }
+    m_xrFrame = false;
+    unlockSubmission();
+  }
+
+  void DxvkDevice::startLoadingXrFrames() {
+    if (m_xrFrame) throw DxvkError("GK3HD: loading overlaps an engine XR frame");
+    m_xrLoading.start([this] {
+      auto* host = m_instance->xr();
+      if (!host) throw DxvkError("GK3HD: loading has no XR host");
+      auto& runtime = host->runtime();
+      if (!runtime.readyForFrame()) return false;
+      // xrWaitFrame cannot touch VkQueue. Do not hold the uploader's queue
+      // while waiting; protect xrBeginFrame and failure cleanup explicitly.
+      runtime.beginFrame([this] { lockSubmission(); }, [this] { unlockSubmission(); });
+      lockSubmission();
+      try {
+        // Empty frames never acquire swapchain images, access game resources,
+        // call D3D rendering or deliver controller events to the native game.
+        runtime.endFrame(false);
+      } catch (...) { unlockSubmission(); throw; }
+      unlockSubmission();
+      return true;
+    }, [](const std::exception_ptr& failure) {
+      try { std::rethrow_exception(failure); }
+      catch (const std::exception& error) {
+        Logger::err(str::format("GK3HD OpenXR session ended: loading frame pump: ", error.what()));
+      } catch (...) { Logger::err("GK3HD OpenXR session ended: loading frame pump failed"); }
+    });
+  }
+
+  void DxvkDevice::stopLoadingXrFrames() {
+    const bool active = m_xrLoading.active();
+    const auto before = m_xrLoading.frames();
+    m_xrLoading.stop();
+    if (active) Logger::info(str::format("GK3HD loading XR handoff: frames=", m_xrLoading.frames(),
+                                       " joined-after=", m_xrLoading.frames()-before));
+  }
+#endif
