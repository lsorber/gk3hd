+  void D3D9DeviceEx::ConfigureSharedXr(const gk3hd::vr::EyeCamera* source,
+                                    const std::array<gk3hd::vr::EyeCamera,2>* eyes) {
+    if (source && eyes) {
+      std::array<Matrix4,4> transforms{};
+      const uint32_t width = uint32_t((*eyes)[0].camera.width);
+      const uint32_t height = uint32_t((*eyes)[0].camera.height);
+      for (unsigned i=0; i<4; ++i) {
+        const unsigned eye = i%2;
+        const auto matrix = gk3hd::vr::shared_projection::transform(*source, (*eyes)[eye],
+          width*2, height, eye*width, m_alternatePixelCenter ? .5 : 0., i>=2);
+        float values[4][4]{};
+        for (unsigned row=0; row<4; ++row) for (unsigned column=0; column<4; ++column) {
+          values[row][column] = float(matrix[row][column]);
+          if (!std::isfinite(values[row][column])) throw DxvkError("GK3HD: stereo matrix overflow");
+        }
+        transforms[i] = Matrix4(values);
+      }
+      for(unsigned eye=0;eye<2;eye++){
+        const auto full=gk3hd::vr::shared_projection::product(gk3hd::vr::shared_projection::view((*eyes)[eye],false),
+          gk3hd::vr::shared_projection::projection((*eyes)[eye],width*2,height,eye*width,m_alternatePixelCenter?.5:0.));
+        for(unsigned r=0;r<4;r++)for(unsigned c=0;c<4;c++)
+          m_gkNativeViews[eye*16+r*4+c]=float(full[r][c]);
+      }
+      m_xrSharedTransforms = transforms;
+      m_xrSharedWidth = width; m_xrSharedHeight = height;
+      m_xrSharedDepthA = source->projection.depthA; m_xrSharedDepthB = source->projection.depthB;
+      m_xrSharedPacked = m_xrSharedGeometry = true;
+    } else m_xrSharedGeometry = false;
+    m_flags.set(D3D9DeviceFlag::DirtyFFVertexShader);
+    m_flags.set(D3D9DeviceFlag::DirtyFFVertexData);
+  }
