+  bool D3D9DeviceEx::SharedXrSupported() const {
+    // First integration targets standalone; ordinary PC-VR keeps independent
+    // eye draws. Selection uses capabilities, never HMD/driver names or files.
+    return env::getEnvVar("GK3HD_STANDALONE_LAUNCH") == "1" &&
+      m_dxvkDevice->features().core.features.shaderClipDistance;
+  }
