+  HRESULT D3D9XrFrame(void* device, uint32_t operation, void* output) {
+    if (operation > uint32_t(gk3hd::vr::FrameOperation::Cancel)) return E_INVALIDARG;
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    if (!modern || !modern->GetDXVKDevice()->instance()->xr()) return E_NOTIMPL;
+    // The raw diagnostic bridge must never steal a coordinated engine frame.
+    if (modern->XrFrames().pending()) return E_UNEXPECTED;
+    auto gpu = modern->GetDXVKDevice();
+    try {
+      gpu->stopLoadingXrFrames();
+      switch (gk3hd::vr::FrameOperation(operation)) {
+        case gk3hd::vr::FrameOperation::Begin: {
+          auto* frame = static_cast<gk3hd::vr::FrameViews*>(output);
+          if (!frame || frame->size != sizeof(*frame)) return E_INVALIDARG;
+          frame->input = {};
+          XrTransport transport{modern};
+          if (!transport.begin(*frame)) return S_FALSE;
+          return S_OK;
+        }
+        case gk3hd::vr::FrameOperation::Left: modern->WriteXrEye(0); break;
+        case gk3hd::vr::FrameOperation::Right: modern->WriteXrEye(1); break;
+        case gk3hd::vr::FrameOperation::Submit: gpu->endXrFrame(true); break;
+        case gk3hd::vr::FrameOperation::Cancel: gpu->endXrFrame(false); break;
+      }
+      return S_OK;
+    } catch (const DxvkError& error) {
+      Logger::err(str::format("GK3HD: XR frame bridge: ", error.message()));
+      return E_FAIL;
+    } catch (const std::exception& error) {
+      Logger::err(str::format("GK3HD: XR frame bridge: ", error.what()));
+      return E_FAIL;
+    } catch (...) {
+      Logger::err("GK3HD: unknown XR frame bridge failure");
+      return E_FAIL;
+    }
+  }
