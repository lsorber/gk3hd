+  void D3D9DeviceEx::WriteXrEye(unsigned eye, float visibility) {
+    D3D9DeviceLock lock = LockDevice();
+    if (!m_state.renderTargets[0]) throw DxvkError("GK3HD: XR draw has no render target");
+    const auto image = m_state.renderTargets[0]->GetCommonTexture()->GetImage();
+    // A full clear can stay deferred in the producer context even after a
+    // command-list flush. Finish its render pass before another context reads
+    // the image. An identity transform flushes deferred clears without a
+    // readback, an extra copy, or changing the image's default layout.
+    EmitCs([image](DxvkContext* ctx) {
+      ctx->transformImage(image, image->getAvailableSubresources(), image->info().layout, image->info().layout);
+    });
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+    m_dxvkDevice->writeXrEye(eye, image, m_implicitSwapchain->GetXrGammaBlitter(visibility != 1.f),
+                           false, {}, visibility);
+  }
+
+  void D3D9DeviceEx::MirrorXrEye(uint32_t width, uint32_t height) {
+    D3D9DeviceLock lock = LockDevice();
+    const auto& eye = m_xrEyeTargets[0];
+    if (eye.color == nullptr) throw DxvkError("GK3HD: no completed XR mirror eye");
+    Com<IDirect3DSurface9> target;
+    D3DSURFACE_DESC desc{};
+    if (FAILED(GetRenderTarget(0, &target)) || FAILED(target->GetDesc(&desc)) ||
+        desc.Width != width || desc.Height != height || target.ptr() == eye.color.ptr())
+      throw DxvkError(str::format("GK3HD: XR mirror target ", desc.Width, "x", desc.Height,
+        " does not match canvas ", width, "x", height));
+    const auto crop = gk3hd::vr::mirrorCrop(eye.extent.width, eye.extent.height, width, height);
+    const RECT source{crop.left, crop.top, crop.right, crop.bottom};
+    // Copy the engine color before OpenXR/desktop presentation gamma. No eye
+    // acquisition, readback, state change, geometry pass or page flip here.
+    if (FAILED(StretchRect(eye.color.ptr(), &source, target.ptr(), nullptr, D3DTEXF_LINEAR)))
+      throw DxvkError("GK3HD: XR eye mirror copy failed");
+  }
