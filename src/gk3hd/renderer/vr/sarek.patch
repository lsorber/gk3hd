diff --git a/src/dxvk/shaders/gk3hd_world_frag.frag b/src/dxvk/shaders/gk3hd_world_frag.frag
new file mode 100644
index 0000000..b8aae91
--- /dev/null
+++ b/src/dxvk/shaders/gk3hd_world_frag.frag
@@ -0,0 +1,26 @@
+#version 450
+// Both stereo instances of each indirect draw select the same surface. This
+// index is dynamically uniform in that draw's invocation group.
+layout(constant_id=0) const uint TextureCount=256u;
+struct Material { vec4 uvTransform;vec4 color;uvec4 texturesFlags;vec4 keyLow;vec4 keyHigh; };
+layout(std430,set=0,binding=0) readonly buffer Materials { Material values[]; } materials;
+layout(set=0,binding=2) uniform texture2D images[TextureCount];
+layout(set=0,binding=3) uniform sampler imageSampler;
+layout(set=0,binding=4) uniform sampler lightSampler;
+layout(location=0) in vec2 baseUv;
+layout(location=1) in vec2 lightUv;
+layout(location=2) flat in uint surface;
+layout(location=3) flat in vec4 materialColor;
+layout(location=4) flat in uvec4 materialTextures;
+layout(location=5) flat in vec4 materialKeyLow;
+layout(location=6) flat in vec4 materialKeyHigh;
+layout(location=0) out vec4 color;
+void main() {
+  Material m=Material(vec4(0),materialColor,materialTextures,materialKeyLow,materialKeyHigh);
+  vec4 base=texture(sampler2D(images[m.texturesFlags.x],imageSampler),baseUv);
+  uint flags=m.texturesFlags.z;
+  if((flags&1u)!=0u&&all(greaterThanEqual(base.rgb,m.keyLow.rgb))&&all(lessThanEqual(base.rgb,m.keyHigh.rgb))) discard;
+  if((flags&4u)!=0u&&(((m.texturesFlags.w&1u)!=0u)?!(base.a>m.keyHigh.w):(base.a<m.keyHigh.w))) discard;
+  color=base*m.color;
+  if((flags&2u)!=0u) color.rgb*=texture(sampler2D(images[m.texturesFlags.y],lightSampler),lightUv).rgb*m.keyLow.w;
+}
