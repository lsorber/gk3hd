+  HRESULT D3D9XrItemHint(void* device, const void* request, const void* catalog, uint32_t bytes) {
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    if (!modern || !request || !catalog) return E_POINTER;
+    if (!modern->GetDXVKDevice()->instance()->xr()) return E_NOTIMPL;
+    try {
+      modern->XrItemHint().configure(*static_cast<const gk3hd::vr::ItemHintRequest*>(request),catalog,bytes);
+      return S_OK;
+    } catch (const std::exception&) { modern->XrItemHint().close(); return E_INVALIDARG; }
+  }
