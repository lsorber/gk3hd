+  void DxvkDevice::configureXrPanel(uint32_t width, uint32_t height) {
+    auto* host = m_instance->xr();
+    if (!host || !width || !height || (m_xrFrame && m_xrWritten[2]))
+      throw DxvkError("GK3HD: invalid XR panel configuration");
+    if (m_xrPanelExtent.width == width && m_xrPanelExtent.height == height && !m_xrImages[2].empty()) return;
+    // Resize only on a canvas change, never on the ordinary frame path. Drain
+    // before discarding borrowed wrappers and destroying their runtime images.
+    if (!host->runtime().panelImages().empty()) waitForIdle();
+    m_xrScratch[2] = nullptr; m_xrImages[2].clear(); m_xrPanelExtent = {};
+    lockSubmission();
+    try {
+      host->runtime().destroyPanelSwapchain();
+      host->runtime().createPanelSwapchain(host->format(), width, height);
+    } catch (...) { unlockSubmission(); throw; }
+    unlockSubmission();
+    try {
+      auto info = m_xrImages[0].at(0)->info();
+      info.extent = {width, height, 1};
+      for (const auto& image : host->runtime().panelImages())
+        m_xrImages[2].push_back(new DxvkImage(this, info, image.image));
+      m_xrPanelExtent = {width, height};
+    } catch (...) {
+      m_xrImages[2].clear();
+      lockSubmission(); host->runtime().destroyPanelSwapchain(); unlockSubmission();
+      throw;
+    }
+  }
