+  void DxvkDevice::initializeXrImages() {
+    auto* host = m_instance->xr();
+    if (!host) throw DxvkError("GK3HD: XR image wrapping without an XR host");
+    std::array<std::vector<Rc<DxvkImage>>, 5> wrapped;
+    for (unsigned eye = 0; eye < 2; ++eye) {
+      const auto& view = host->runtime().configuration()[eye];
+      DxvkImageCreateInfo info{};
+      info.type = VK_IMAGE_TYPE_2D;
+      info.format = host->format();
+      info.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+      info.extent = {view.recommendedImageRectWidth, view.recommendedImageRectHeight, 1};
+      info.numLayers = info.mipLevels = 1;
+      info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+      info.stages = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+      info.access = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT
+                  | VK_ACCESS_TRANSFER_WRITE_BIT;
+      // The runtime guarantees this layout after a successful image wait and
+      // requires it again on release. Never initialize or write a borrowed
+      // image before acquiring/waiting it, and never free its Vulkan memory.
+      info.layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      info.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      for (const auto& image : host->runtime().images(eye))
+        wrapped[eye].push_back(new DxvkImage(this, info, image.image));
+    }
+    m_xrImages = std::move(wrapped);
+  }
