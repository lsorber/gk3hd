+  void D3D9DeviceEx::BindXrEye(unsigned eye, uint32_t width, uint32_t height) {
+    if (eye >= 2 || !width || !height) throw DxvkError("GK3HD: invalid XR eye target");
+    if (eye == 0) m_xrSharedPacked = false;
+    auto check = [](HRESULT result) {
+      if (FAILED(result)) throw DxvkError("GK3HD: XR eye target allocation/bind failed");
+    };
+    Com<IDirect3DSurface9> source, depth;
+    check(GetRenderTarget(0, &source));
+    D3DSURFACE_DESC colorDesc{}, depthDesc{};
+    check(source->GetDesc(&colorDesc));
+    const auto hasDepth = GetDepthStencilSurface(&depth);
+    if (FAILED(hasDepth) && hasDepth != D3DERR_NOTFOUND)
+      check(hasDepth);
+    if (depth != nullptr) check(depth->GetDesc(&depthDesc));
+    // The VR near plane is closer than the game's original near plane.
+    // Keep that range without losing depth precision on distant surfaces.
+    const D3DFORMAT nativeDepth = depth != nullptr ? depthDesc.Format : D3DFMT_D16;
+    const D3DFORMAT depthFormat = nativeDepth == D3DFMT_D16 || nativeDepth == D3DFMT_D16_LOCKABLE
+        ? D3DFMT_D24X8 : nativeDepth;
+    const VkExtent2D extent{width, height};
+    auto& target = m_xrEyeTargets[eye];
+    const auto& runtime = m_dxvkDevice->instance()->xr()->runtime();
+    const bool extentMatches = width == runtime.configuration()[eye].recommendedImageRectWidth *
+        (runtime.packedEyeTargets() ? 2u : 1u) && height == runtime.configuration()[eye].recommendedImageRectHeight;
+    const bool direct = extentMatches && m_xrDirectVisible && m_dxvkDevice->directXrAttachment(eye) &&
+                        m_implicitSwapchain->GetXrGammaBlitter() == nullptr;
+    if (direct) {
+      const auto image = m_dxvkDevice->acquireXrAttachment(eye);
+      const auto format = image->info().format == VK_FORMAT_R8G8B8A8_SRGB ? D3DFMT_A8B8G8R8 : D3DFMT_A8R8G8B8;
+      auto& colors = m_xrBorrowedColors[eye];
+      auto found = std::find_if(colors.begin(),colors.end(),[&](const auto& surface) {
+        return surface->GetCommonTexture()->GetImage() == image;
+      });
+      if (found == colors.end()) {
+        D3D9_COMMON_TEXTURE_DESC desc{};
+        desc.Width = width; desc.Height = height; desc.Depth = 1;
+        desc.ArraySize = desc.MipLevels = 1;
+        desc.Usage = D3DUSAGE_RENDERTARGET; desc.Format = EnumerateFormat(format);
+        desc.Pool = D3DPOOL_DEFAULT; desc.MultiSample = D3DMULTISAMPLE_NONE;
+        desc.IsAttachmentOnly = true;
+        Com<D3D9Surface> surface = new D3D9Surface(this,&desc,nullptr,nullptr,image);
+        colors.push_back(surface.ptr());
+        found = colors.end()-1;
+        Logger::info(str::format("GK3HD: Direct XR attachment eye=",eye," extent=",width,"x",height));
+      }
+      target.color = *found; target.colorFormat = format; target.borrowed = true;
+    } else if (target.color == nullptr || target.borrowed || target.extent != extent || target.colorFormat != colorDesc.Format) {
+      Com<IDirect3DTexture9> texture;
+      Com<IDirect3DSurface9> surface;
+      check(CreateTexture(width,height,1,D3DUSAGE_RENDERTARGET,colorDesc.Format,D3DPOOL_DEFAULT,&texture,nullptr));
+      check(texture->GetSurfaceLevel(0,&surface));
+      target.color = static_cast<D3D9Surface*>(surface.ptr());
+      target.colorFormat = colorDesc.Format; target.borrowed = false;
+      Logger::info(str::format("GK3HD: Private XR eye=",eye," extent=",width,"x",height,
+        " visible=",m_xrDirectVisible," neutral=",m_implicitSwapchain->GetXrGammaBlitter()==nullptr,
+        " direct=",m_dxvkDevice->directXrAttachment(eye)," extentMatch=",extentMatches));
+    }
+    if (target.depth == nullptr || target.extent != extent || target.depthFormat != depthFormat) {
+      Com<IDirect3DSurface9> surface;
+      check(CreateDepthStencilSurface(width,height,depthFormat,D3DMULTISAMPLE_NONE,0,FALSE,&surface,nullptr));
+      target.depth = static_cast<D3D9Surface*>(surface.ptr()); target.depthFormat = depthFormat;
+    }
+    target.extent = extent;
+    check(SetDepthStencilSurface(nullptr));
+    check(SetRenderTarget(0, target.color.ptr()));
+    check(SetDepthStencilSurface(target.depth.ptr()));
+    D3DVIEWPORT9 viewport{0, 0, width, height, 0.f, 1.f};
+    check(SetViewport(&viewport));
+    check(SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE));
+  }
+
+  void D3D9DeviceEx::WriteXrEye(unsigned eye, float visibility) {
+    D3D9DeviceLock lock = LockDevice();
+    if (!m_state.renderTargets[0]) throw DxvkError("GK3HD: XR draw has no render target");
+    const auto image = m_state.renderTargets[0]->GetCommonTexture()->GetImage();
+    const bool packedDirect = m_xrSharedPacked && m_dxvkDevice->ownsXrAttachment(0,image);
+    if (packedDirect || m_dxvkDevice->ownsXrAttachment(eye,image)) {
+      if (visibility != 1.f || m_implicitSwapchain->GetXrGammaBlitter() != nullptr)
+        throw DxvkError("GK3HD: direct XR attachment eligibility changed during drawing");
+      m_dxvkDevice->completeXrAttachment(eye,packedDirect);
+      return;
+    }
+    // A full clear can stay deferred in the producer context even after a
+    // command-list flush. Finish its render pass before another context reads
+    // the image. An identity transform flushes deferred clears without a
+    // readback, an extra copy, or changing the image's default layout.
+    EmitCs([image](DxvkContext* ctx) {
+      ctx->transformImage(image, image->getAvailableSubresources(), image->info().layout, image->info().layout);
+    });
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+    const bool packed = m_dxvkDevice->instance()->xr()->runtime().packedEyeTargets();
+    m_dxvkDevice->writeXrEye(eye, image, m_implicitSwapchain->GetXrGammaBlitter(visibility != 1.f || m_dxvkDevice->directXrOutput(eye) || packed),
+                           false, {}, visibility, {}, nullptr,
+                           m_xrSharedPacked ? VkRect2D{{int32_t(eye*m_xrSharedWidth),0},
+                             {m_xrSharedWidth,m_xrSharedHeight}} : VkRect2D{});
+  }
+
+  void D3D9DeviceEx::MirrorXrEye(uint32_t width, uint32_t height) {
+    D3D9DeviceLock lock = LockDevice();
+    const auto& eye = m_xrEyeTargets[0];
+    if (eye.color == nullptr) throw DxvkError("GK3HD: no completed XR mirror eye");
+    Com<IDirect3DSurface9> target;
+    D3DSURFACE_DESC desc{};
+    if (FAILED(GetRenderTarget(0, &target)) || FAILED(target->GetDesc(&desc)) ||
+        desc.Width != width || desc.Height != height || target.ptr() == eye.color.ptr())
+      throw DxvkError(str::format("GK3HD: XR mirror target ", desc.Width, "x", desc.Height,
+        " does not match canvas ", width, "x", height));
+    const auto crop = gk3hd::vr::mirrorCrop(m_xrSharedPacked ? m_xrSharedWidth : eye.extent.width,
+                                           eye.extent.height, width, height);
+    const RECT source{crop.left, crop.top, crop.right, crop.bottom};
+    // Copy the engine color before OpenXR/desktop presentation gamma. No eye
+    // acquisition, readback, state change, geometry pass or page flip here.
+    if (FAILED(StretchRect(eye.color.ptr(), &source, target.ptr(), nullptr, D3DTEXF_LINEAR)))
+      throw DxvkError("GK3HD: XR eye mirror copy failed");
+  }
+
+  void D3D9DeviceEx::WriteXrPanel(const gk3hd::vr::PanelFrame& frame,
+                               const gk3hd::vr::OverlayImage* subtitles) {
+    D3D9DeviceLock lock = LockDevice();
+    if (!m_state.renderTargets[0]) throw DxvkError("GK3HD: XR panel has no render target");
+    const auto image = m_state.renderTargets[0]->GetCommonTexture()->GetImage();
+    if (image->info().extent.width != frame.canvasWidth || image->info().extent.height != frame.canvasHeight)
+      throw DxvkError(str::format("GK3HD: XR panel canvas ", frame.canvasWidth, "x", frame.canvasHeight,
+        " does not match target ", image->info().extent.width, "x", image->info().extent.height));
+    EmitCs([image](DxvkContext* ctx) {
+      ctx->transformImage(image, image->getAvailableSubresources(), image->info().layout, image->info().layout);
+    });
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+    m_dxvkDevice->configureXrPanel(frame.canvasWidth, frame.canvasHeight);
+    VkRect2D matte{};
+    if (subtitles) {
+      const auto& bounds = subtitles->bounds;
+      if (subtitles->width != frame.canvasWidth || subtitles->height != frame.canvasHeight ||
+          bounds.empty() || bounds.right > frame.canvasWidth || bounds.bottom > frame.canvasHeight)
+        throw DxvkError("GK3HD: invalid modal subtitle region");
+      matte = {{int32_t(bounds.left), int32_t(bounds.top)}, {bounds.width(), bounds.height()}};
+    }
+    m_dxvkDevice->writeXrEye(2, image, m_implicitSwapchain->GetXrGammaBlitter(), false, {}, 1.f, matte, &frame.pointer);
+  }
+
+  void D3D9DeviceEx::WriteXrOverlay(const gk3hd::vr::OverlayImage& overlay, unsigned target,
+                                  const gk3hd::vr::PanelPointer* pointer, bool retainPixels) {
+    D3D9DeviceLock lock = LockDevice();
+    if (target < 2 || target > 5 || (retainPixels && (target != 4 || pointer)))
+      throw DxvkError("GK3HD: invalid overlay target");
+    auto& upload = m_xrOverlayUploads[target - 2];
+    const auto crop = gk3hd::vr::overlayUploadRegion(overlay);
+    VkExtent2D capacity{gk3hd::vr::overlayTextureExtent(crop.width(), overlay.width),
+                        gk3hd::vr::overlayTextureExtent(crop.height(), overlay.height)};
+    const VkExtent2D canvas{overlay.width, overlay.height};
+    if (canvas == upload.canvas) {
+      capacity.width = std::max(capacity.width, upload.extent.width);
+      capacity.height = std::max(capacity.height, upload.extent.height);
+    }
+    if (upload.texture == nullptr || upload.extent != capacity || upload.canvas != canvas) {
+      Com<IDirect3DTexture9> texture;
+      if (FAILED(CreateTexture(capacity.width, capacity.height, 1, D3DUSAGE_DYNAMIC,
+                              D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &texture, nullptr)))
+        throw DxvkError("GK3HD: cannot allocate transparent interface texture");
+      // Private ownership must not retain our parent device through a public
+      // texture reference, otherwise device/session recreation leaks a cycle.
+      upload.texture = static_cast<D3D9Texture2D*>(texture.ptr());
+      upload.extent = capacity; upload.canvas = canvas;
+      upload.pixels.clear(); upload.immutableImage = nullptr;
+    }
+    auto* texture = upload.texture->GetCommonTexture();
+    const bool retainable = retainPixels && !m_implicitSwapchain->GetXrGammaBlitter();
+    const std::array<uint32_t,4> cropKey{crop.left,crop.top,crop.width(),crop.height()};
+    if (retainable && !upload.pixels.empty() && upload.crop == cropKey &&
+        upload.immutableImage == texture->GetImage() && upload.pixels == overlay.pixels &&
+        m_dxvkDevice->reuseXrSubtitle()) {
+      if ((++upload.reuseCount & 511) == 1)
+        Logger::info(str::format("GK3HD: retained item layer reused count=",upload.reuseCount));
+      return;
+    }
+    D3DLOCKED_BOX locked;
+    if (FAILED(LockImage(texture, 0, 0, &locked, nullptr, D3DLOCK_DISCARD)))
+      throw DxvkError("GK3HD: cannot upload transparent interface texture");
+    for (uint32_t y = 0; y < crop.height(); ++y)
+      std::memcpy(static_cast<uint8_t*>(locked.pBits) + size_t(y)*locked.RowPitch,
+                  overlay.pixels.data() + size_t(y+crop.top)*overlay.width + crop.left, size_t(crop.width())*4);
+    // Lock the full private texture with DISCARD to rename its staging buffer
+    // without waiting for old GPU readers. Only initialized crop rows are dirty;
+    // unused capacity is neither uploaded nor sampled by the exact-size blit.
+    const D3DBOX uploaded{0, 0, crop.width(), crop.height(), 0, 1};
+    texture->ClearDirtyBoxes(); texture->AddDirtyBox(&uploaded, 0);
+    if (FAILED(UnlockImage(texture, 0, 0))) throw DxvkError("GK3HD: interface upload failed");
+    const auto image = texture->GetImage();
+    EmitCs([image](DxvkContext* ctx) {
+      ctx->transformImage(image, image->getAvailableSubresources(), image->info().layout, image->info().layout);
+    });
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+    if (target == 5) m_dxvkDevice->configureXrPointer();
+    else if (target == 4) m_dxvkDevice->configureXrSubtitle(overlay.width, overlay.height);
+    else if (target == 3) m_dxvkDevice->configureXrKeyboard(overlay.width, overlay.height);
+    else if (target == 2) m_dxvkDevice->configureXrPanel(overlay.width, overlay.height);
+    else throw DxvkError("GK3HD: invalid overlay target");
+    const VkRect2D destination{{int32_t(crop.left), int32_t(crop.top)}, {crop.width(), crop.height()}};
+    m_dxvkDevice->writeXrEye(target, image, m_implicitSwapchain->GetXrGammaBlitter(true), true, destination, 1.f, {}, pointer);
+    if (retainable) { upload.pixels = overlay.pixels; upload.crop = cropKey; upload.immutableImage = image; }
+    else { upload.pixels.clear(); upload.immutableImage = nullptr; }
+  }
