+  HRESULT D3D9XrScene(void* device, const void* request) {
+    if (!device || !request) return E_POINTER;
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    if (!modern->GetDXVKDevice()->instance()->xr()) return E_NOTIMPL;
+    struct Transport final : gk3hd::vr::SceneTransport {
+      D3D9DeviceEx* device;
+      XrTransport backend;
+      bool deferred;
+      bool mirror;
