+
+  void D3D9DeviceEx::FlushXrAttachments() {
+    if (!m_dxvkDevice->pendingXrAttachments()) return;
+    for (unsigned eye=0; eye<2; ++eye) {
+      if (m_xrEyeTargets[eye].color == nullptr) continue;
+      const auto image = m_xrEyeTargets[eye].color->GetCommonTexture()->GetImage();
+      if (!m_dxvkDevice->ownsXrAttachment(eye,image)) continue;
+      EmitCs([image](DxvkContext* context) {
+        context->transformImage(image,image->getAvailableSubresources(),image->info().layout,image->info().layout);
+      });
+    }
+    // This point is after both overlays, mirror and any deferred UI. Submit
+    // all producer use before the one physical packed image is released.
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+  }
