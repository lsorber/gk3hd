+  bool D3D9DeviceEx::XrEyeTargetsBound() {
+    D3D9DeviceLock lock = LockDevice();
+    for (const auto& eye : m_xrEyeTargets)
+      if (eye.color != nullptr && eye.depth != nullptr &&
+          m_state.renderTargets[0].ptr() == eye.color.ptr() &&
+          m_state.depthStencil.ptr() == eye.depth.ptr()) return true;
+    return false;
