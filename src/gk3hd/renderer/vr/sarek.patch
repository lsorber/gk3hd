+
+  HRESULT D3D9XrPanel(void* device, uint32_t operation, void* request, const void* overlay,
+                     const void* displayOverlay, const void* subtitleOverlay) {
+    if (operation > uint32_t(gk3hd::vr::PanelOperation::Loading)) return E_INVALIDARG;
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    if (!modern || !modern->GetDXVKDevice()->instance()->xr()) return E_NOTIMPL;
+    auto* frame = static_cast<gk3hd::vr::PanelFrame*>(request);
+    XrTransport transport{modern};
+    try {
+      if (modern->GetDXVKDevice()->loadingXrFrames() &&
+          (operation == uint32_t(gk3hd::vr::PanelOperation::Loading) ||
+           operation == uint32_t(gk3hd::vr::PanelOperation::Close))) {
+        // Nested native loading boundaries and empty UI finalizers do not
+        // take frame ownership away from the helper before a real draw.
+        return S_OK;
+      }
+      modern->GetDXVKDevice()->stopLoadingXrFrames();
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::Loading)) {
+        modern->XrScene().retireNavigation();
+        modern->XrScene().retireListener();
+        modern->XrPanel().close(); modern->XrText().close(); modern->XrGameMenu().close(); modern->XrItemHint().close();
+        const bool submitted = modern->XrFrames().blank(transport);
+        modern->GetDXVKDevice()->startLoadingXrFrames();
+        return submitted ? S_OK : S_FALSE;
+      }
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::Blank)) {
+        modern->XrScene().retireNavigation();
+        modern->XrScene().retireListener();
+        modern->XrPanel().close();
+        modern->XrText().close(); modern->XrGameMenu().close(); modern->XrItemHint().close();
+        return modern->XrFrames().blank(transport) ? S_OK : S_FALSE;
+      }
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::Close)) {
+        modern->XrScene().retireNavigation();
+        if (!modern->XrFrames().worldReady()) modern->XrScene().retireListener();
+        modern->XrPanel().close();
+        modern->XrText().close(); modern->XrGameMenu().close(); modern->XrItemHint().close();
+        // Finalize a deferred world even if there is no interface this frame.
+        modern->XrFrames().finish(transport);
+        return S_OK;
+      }
+      if (!frame) {
+        modern->XrScene().retireListener();
+        modern->XrText().close(); modern->XrGameMenu().close(); modern->XrItemHint().close();
+        modern->XrFrames().cancel(transport);
+        return E_POINTER;
+      }
+      gk3hd::vr::PanelState::validate(*frame);
+      frame->geometry = {}; frame->input = {}; frame->pointer = {};
+      const bool isolated = operation == uint32_t(gk3hd::vr::PanelOperation::Caption) ||
+                            operation == uint32_t(gk3hd::vr::PanelOperation::Overlay);
+      const bool modalSubtitles = operation == uint32_t(gk3hd::vr::PanelOperation::ModalSubtitles);
+      if (operation != uint32_t(gk3hd::vr::PanelOperation::World) &&
+          (!isolated || (frame->flags & gk3hd::vr::PanelReadableMenu))) modern->XrScene().retireNavigation();
+      if (!isolated && operation != uint32_t(gk3hd::vr::PanelOperation::World))
+        modern->XrScene().retireListener();
+      if (isolated != bool(frame->flags & gk3hd::vr::PanelTransparent) || (isolated && !overlay))
+        throw DxvkError("GK3HD: inconsistent isolated interface request");
+      if (displayOverlay && (!isolated || !(frame->flags & gk3hd::vr::PanelReadableMenu)))
+        throw DxvkError("GK3HD: display-only companion outside readable menu frame");
+      if ((subtitleOverlay && !isolated && !modalSubtitles) || (modalSubtitles && !subtitleOverlay))
+        throw DxvkError("GK3HD: subtitle without a valid world or native screen");
+      if (isolated && !modern->XrFrames().worldReady()) {
+        modern->XrScene().retireListener();
+        modern->XrPanel().close(); modern->XrText().close(); modern->XrGameMenu().close(); modern->XrItemHint().close(); modern->XrFrames().cancel(transport);
+        return S_FALSE;
+      }
+      if (operation == uint32_t(gk3hd::vr::PanelOperation::World)) {
+        modern->XrPanel().close();
+        modern->XrText().close(); modern->XrGameMenu().close();
+        if (!modern->XrFrames().worldReady()) {
+          modern->XrFrames().cancel(transport);
+          return S_FALSE;
+        }
+        const auto* sampled = modern->XrFrames().begin(transport);
+        if (!sampled) throw DxvkError("GK3HD: ready XR world has no input snapshot");
+        gk3hd::vr::PanelState::world(*frame, *sampled);
+        modern->XrGameMenu().filterInput(*frame);
+        const auto hint = modern->XrItemHint().prepare(*sampled,frame->hand);
+        if (hint) {
+          modern->WriteXrOverlay(modern->XrItemHint().image(),4,nullptr,true);
+          transport.subtitle = &*hint;
+        }
+        modern->XrFrames().finish(transport);
+        return S_OK;
+      }
+      const auto* views = modern->XrFrames().begin(transport);
+      if (!views) {
+        modern->XrText().close(); modern->XrGameMenu().close(); modern->XrItemHint().close();
+        modern->XrFrames().finish(transport);
+        return S_FALSE;
+      }
+      modern->XrPanel().prepare(*frame, *views, isolated ? static_cast<const gk3hd::vr::OverlayImage*>(overlay) : nullptr);
+      if (isolated) modern->XrGameMenu().filterInput(*frame);
+      const auto menu = isolated ? gk3hd::vr::GameMenuFrame{} : modern->XrGameMenu().prepare(*frame);
+      if (menu.visible) {
+        modern->XrText().close();
+        modern->WriteXrOverlay(modern->XrGameMenu().image(menu), 2, &menu.pointer);
+      } else if (isolated) modern->WriteXrOverlay(*static_cast<const gk3hd::vr::OverlayImage*>(overlay), 2, &frame->pointer);
+      else modern->WriteXrPanel(*frame, static_cast<const gk3hd::vr::OverlayImage*>(subtitleOverlay));
+      gk3hd::vr::KeyboardFrame keys{};
+      gk3hd::vr::PanelGeometry labels{};
+      gk3hd::vr::PanelGeometry captions{};
+      std::optional<gk3hd::vr::PanelGeometry> itemHint;
+      if (menu.visible) {
+        modern->XrText().close();
+      } else if (isolated) {
+        modern->XrText().close(); modern->XrGameMenu().close();
+        if (displayOverlay) {
+          modern->WriteXrOverlay(*static_cast<const gk3hd::vr::OverlayImage*>(displayOverlay), 3);
+          labels = modern->XrPanel().canvasGeometry();
+          transport.keyboard = &labels;
+          transport.auxiliaryTransparent = true;
+        }
+      }
+      else {
+        keys = modern->XrText().prepare(*frame);
+        if (keys.visible) {
+          modern->WriteXrOverlay(modern->XrText().image(keys), 3);
+          transport.keyboard = &keys.geometry;
+        }
+      }
+      if (subtitleOverlay && !menu.visible) {
+        modern->WriteXrOverlay(*static_cast<const gk3hd::vr::OverlayImage*>(subtitleOverlay), 4);
+        captions = modern->XrPanel().subtitleGeometry(frame->canvasWidth, frame->canvasHeight);
+        transport.subtitle = &captions;
+      }
+      // Noninteractive score/tooltips still belong to world exploration.
+      // Native menus and keyboard/caption layers retain display priority.
+      const bool worldLabels = isolated && !(frame->flags & gk3hd::vr::PanelReadableMenu) &&
+        static_cast<const gk3hd::vr::OverlayImage*>(overlay)->interactiveBounds.empty();
+      if (!menu.visible && !(frame->flags & gk3hd::vr::PanelDisplayOnly) && (!isolated || worldLabels) && !keys.visible &&
+          !subtitleOverlay && !displayOverlay) {
+        itemHint = modern->XrItemHint().prepare(*views,frame->hand,isolated ? nullptr : frame);
+        if (itemHint) {
+          modern->WriteXrOverlay(modern->XrItemHint().image(),4,nullptr,true);
+          transport.subtitle = &*itemHint;
+        }
+      }
+      // The scene ray cannot cover a separate interface composition layer.
+      // Draw the same configured controller ray through menus, inventory and
+      // the text keyboard, even while the trigger is held or misses the panel.
+      const bool interactive = !isolated ||
+        !static_cast<const gk3hd::vr::OverlayImage*>(overlay)->interactiveBounds.empty();
+      const auto pointer = interactive
+        ? gk3hd::vr::panelAimLine(*views, *frame,
+                                  keys.visible ? &keys.geometry : nullptr)
+        : std::optional<gk3hd::vr::PanelAimLine>{};
+      if (pointer) {
+        gk3hd::vr::OverlayImage pixel{};
+        pixel.width = pixel.height = 1; pixel.bounds = {0, 0, 1, 1};
+        pixel.pixels = {pointer->hit ? 0xe6e6e6e6u : 0x55555555u};
+        modern->WriteXrOverlay(pixel, 5);
+        transport.pointer = &pointer->layer;
+      }
+      modern->XrFrames().finish(transport, &frame->geometry);
+      return S_OK;
+    } catch (const DxvkError& error) {
+      Logger::err(str::format("GK3HD: XR panel bridge: ", error.message()));
+    } catch (const std::exception& error) {
+      Logger::err(str::format("GK3HD: XR panel bridge: ", error.what()));
+    } catch (...) {
+      Logger::err("GK3HD: unknown XR panel bridge failure");
+    }
+    if (frame) { frame->geometry = {}; frame->input = {}; frame->pointer = {}; }
+    modern->XrScene().retireListener();
+    modern->XrText().close(); modern->XrGameMenu().close(); modern->XrItemHint().close();
+    try { modern->XrFrames().cancel(transport); } catch (...) { }
+    return E_FAIL;
+  }
+
+  HRESULT D3D9XrListener(void* device, void* request) {
+    if (!device || !request) return E_POINTER;
+    auto* output=static_cast<gk3hd::vr::NativeListenerV1*>(request);
+    if (output->size!=sizeof(*output)) return E_INVALIDARG;
+    auto* modern=static_cast<D3D9DeviceEx*>(device);
+    auto* host=modern->GetDXVKDevice()->instance()->xr();
+    if (!host || !host->runtime().running() || !host->runtime().focused()) {
+      modern->XrScene().retireListener();return S_FALSE;
+    }
+    gk3hd::vr::EngineListenerPose pose{};
+    if (!modern->XrScene().takeListener(pose)) return S_FALSE;
+    try {
+      const auto angles=gk3hd::vr::engineListenerAngles(pose);
+      *output={sizeof(*output),pose,angles[0],angles[1]};
+      return S_OK;
+    } catch (...) {return E_FAIL;}
+  }
+
+  HRESULT D3D9XrScene(void* device, const void* request) {
+    if (!device || !request) return E_POINTER;
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    if (!modern->GetDXVKDevice()->instance()->xr()) return E_NOTIMPL;
+    struct Transport final : gk3hd::vr::SceneTransport {
+      D3D9DeviceEx* device;
+      XrTransport backend;
+      bool deferred;
+      bool mirror;
+      uint32_t width, height;
+      Com<IDirect3DSurface9> color, depth;
+      D3DVIEWPORT9 viewport{};
+      RECT scissor{};
+      DWORD scissorEnabled = FALSE;
+      bool eyeOpen = false;
+      bool shared = false;
+      unsigned selectedSharedEye = 0;
+      uint32_t sharedWidth = 0;
+      Transport(D3D9DeviceEx* value, const gk3hd::vr::SceneV1& scene)
+        : device(value), backend(value), deferred(bool(scene.flags & gk3hd::vr::SceneDeferred)),
+          mirror(bool(scene.flags & gk3hd::vr::SceneMirror)), width(scene.width), height(scene.height) { }
+      bool begin(gk3hd::vr::FrameViews& views) override {
