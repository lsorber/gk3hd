+  void D3D9DeviceEx::WriteXrPanel(const gk3hd::vr::PanelFrame& frame,
+                               const gk3hd::vr::OverlayImage* subtitles) {
+    D3D9DeviceLock lock = LockDevice();
+    if (!m_state.renderTargets[0]) throw DxvkError("GK3HD: XR panel has no render target");
+    const auto image = m_state.renderTargets[0]->GetCommonTexture()->GetImage();
+    if (image->info().extent.width != frame.canvasWidth || image->info().extent.height != frame.canvasHeight)
+      throw DxvkError(str::format("GK3HD: XR panel canvas ", frame.canvasWidth, "x", frame.canvasHeight,
+        " does not match target ", image->info().extent.width, "x", image->info().extent.height));
+    EmitCs([image](DxvkContext* ctx) {
+      ctx->transformImage(image, image->getAvailableSubresources(), image->info().layout, image->info().layout);
+    });
+    Flush();
+    SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+    m_dxvkDevice->configureXrPanel(frame.canvasWidth, frame.canvasHeight);
+    VkRect2D matte{};
+    if (subtitles) {
+      const auto& bounds = subtitles->bounds;
+      if (subtitles->width != frame.canvasWidth || subtitles->height != frame.canvasHeight ||
+          bounds.empty() || bounds.right > frame.canvasWidth || bounds.bottom > frame.canvasHeight)
+        throw DxvkError("GK3HD: invalid modal subtitle region");
+      matte = {{int32_t(bounds.left), int32_t(bounds.top)}, {bounds.width(), bounds.height()}};
+    }
+    m_dxvkDevice->writeXrEye(2, image, m_implicitSwapchain->GetXrGammaBlitter(), false, {}, 1.f, matte, &frame.pointer);
+  }
