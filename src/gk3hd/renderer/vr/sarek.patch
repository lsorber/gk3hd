+struct GkWorldGeometry : public DxvkResource {
+ Rc<DxvkBuffer> vertices,indices;uint32_t vertexCount,indexCount;
+ GkWorldGeometry(const Rc<DxvkDevice>& device,const GkWorldVertex* v,uint32_t nv,const uint16_t* i,uint32_t ni)
+ :vertexCount(nv),indexCount(ni) {
+  if(!nv||nv>65536||!ni||ni>1000000||!v||!i)throw DxvkError("unsupported world geometry");
+  for(uint32_t n=0;n<ni;n++)if(i[n]>=nv)throw DxvkError("world index out of bounds");
+  vertices=gkWorldBuffer(device,v,nv*sizeof(*v),VK_BUFFER_USAGE_VERTEX_BUFFER_BIT,VK_PIPELINE_STAGE_VERTEX_INPUT_BIT,VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT);
+  indices=gkWorldBuffer(device,i,ni*sizeof(*i),VK_BUFFER_USAGE_INDEX_BUFFER_BIT,VK_PIPELINE_STAGE_VERTEX_INPUT_BIT,VK_ACCESS_INDEX_READ_BIT);
+ }
+};
+class GkWorldPass : public DxvkResource {
+ public:
+ Rc<vk::DeviceFn> vkd;Rc<DxvkImageView> color,depth;
+ VkRenderPass renderpass=VK_NULL_HANDLE;VkFramebuffer framebuffer=VK_NULL_HANDLE;
+ VkDescriptorSetLayout descriptors=VK_NULL_HANDLE;VkPipelineLayout layout=VK_NULL_HANDLE;
+ VkPipeline opaquePipeline=VK_NULL_HANDLE;bool opaqueEnabled=false;VkPipeline pipeline=VK_NULL_HANDLE;VkSampler sampler=VK_NULL_HANDLE,lightSampler=VK_NULL_HANDLE;bool native=false;bool anisotropy=false;
+ uint32_t width=0,height=0,textureCount=0;
+ GkWorldPass(const Rc<DxvkDevice>& device,const Rc<DxvkImageView>& c,const Rc<DxvkImageView>& d,uint32_t count,bool nativeMode=false)
+ :vkd(device->vkd()),color(c),depth(d),textureCount(count) {
+  opaqueEnabled=true; // Preserve original order while choosing discard-free runs.
+  native=nativeMode;anisotropy=device->features().core.features.samplerAnisotropy;
+  const auto& f=device->features().core.features;
+  if(!f.multiDrawIndirect||!f.drawIndirectFirstInstance||!f.shaderSampledImageArrayDynamicIndexing||!f.shaderClipDistance)
+   throw DxvkError("world batch features were not enabled on this device");
+  if(!color||!depth||!count||count>512||color->info().numLayers!=1||depth->info().numLayers!=1||
+     color->image()->info().sampleCount!=VK_SAMPLE_COUNT_1_BIT||depth->image()->info().sampleCount!=VK_SAMPLE_COUNT_1_BIT)
+   throw DxvkError("unsupported world batch targets/table");
+  const auto& limits=device->properties().core.properties.limits;
+  if(limits.maxPushConstantsSize<64)throw DxvkError("world view push constant limit");
+  if(count>limits.maxPerStageDescriptorSampledImages||count>limits.maxDescriptorSetSampledImages||
+    count+4>limits.maxPerStageResources||limits.maxPerStageDescriptorSamplers<2)throw DxvkError("world table exceeds actual descriptor limits");
+  const auto ce=color->image()->mipLevelExtent(color->info().minLevel);
+  const auto de=depth->image()->mipLevelExtent(depth->info().minLevel);width=de.width;height=de.height;
+  if(ce.width!=width||ce.height<height||!width||!height)throw DxvkError("world target size mismatch");
+  try{create();}catch(...){destroy();throw;}
+ }
+ ~GkWorldPass(){destroy();}
+ private:
+ void checked(VkResult r){if(r!=VK_SUCCESS)throw DxvkError("world batch pipeline/resource creation failed");}
+ void destroy(){
+  if(opaquePipeline)vkd->vkDestroyPipeline(vkd->device(),opaquePipeline,nullptr);
+  if(pipeline)vkd->vkDestroyPipeline(vkd->device(),pipeline,nullptr);
+  if(layout)vkd->vkDestroyPipelineLayout(vkd->device(),layout,nullptr);
+  if(descriptors)vkd->vkDestroyDescriptorSetLayout(vkd->device(),descriptors,nullptr);
+  if(framebuffer)vkd->vkDestroyFramebuffer(vkd->device(),framebuffer,nullptr);
+  if(renderpass)vkd->vkDestroyRenderPass(vkd->device(),renderpass,nullptr);
+  if(sampler)vkd->vkDestroySampler(vkd->device(),sampler,nullptr);
+  if(lightSampler)vkd->vkDestroySampler(vkd->device(),lightSampler,nullptr);
+ }
+ void create();
+};
+struct GkWorldFrame : public DxvkResource {
+ std::array<float,32> viewData{};
+ Rc<GkWorldGeometry> geometry;Rc<GkWorldPass> pass;
+ std::vector<gk3hd::vr::world_batches::Run> runs;Rc<DxvkBuffer> materials,draws;std::vector<Rc<DxvkImageView>> textures;uint32_t drawCount;
+ GkWorldFrame(const Rc<DxvkDevice>& device,const Rc<GkWorldGeometry>& g,const Rc<GkWorldPass>& p,
+  const GkWorldMaterial* m,uint32_t nm,const float* matrices,const GkWorldDraw* d,uint32_t nd,
+  std::vector<Rc<DxvkImageView>> images):geometry(g),pass(p),textures(std::move(images)),drawCount(nd){
+  if(!geometry||!pass||!nm||nm>8192||!nd||nd>8192||!m||!matrices||!d||textures.size()!=pass->textureCount)throw DxvkError("unsupported world frame");
+  for(uint32_t i=0;i<nm;i++)if(m[i].texturesFlags[0]>=textures.size()||m[i].texturesFlags[1]>=textures.size())throw DxvkError("world material outside texture table");
+  for(uint32_t i=0;i<nd;i++)if(!d[i].count||d[i].count>geometry->indexCount||d[i].first>geometry->indexCount-d[i].count||
+   d[i].instances!=2||d[i].offset!=0||(d[i].firstInstance&1)||(d[i].firstInstance>>1)>=nm)throw DxvkError("world draw outside geometry/materials");
+  for(auto& image:textures)if(!image||image->image()==pass->color->image()||image->image()==pass->depth->image()||image->info().numLayers!=1)throw DxvkError("invalid/aliased world texture");
+  runs=gk3hd::vr::world_batches::partition(d,nd,m,pass->opaqueEnabled);
+  materials=gkWorldBuffer(device,m,nm*sizeof(*m),VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,VK_PIPELINE_STAGE_VERTEX_SHADER_BIT|VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,VK_ACCESS_SHADER_READ_BIT);
+  std::memcpy(viewData.data(),matrices,viewData.size()*sizeof(float));
+  // Preserve shared inputs; each eye gets a single-instance command slice.
+  std::vector<GkWorldDraw> eyeDraws(size_t(nd)*2);
+  for(uint32_t eye=0;eye<2;eye++)for(uint32_t i=0;i<nd;i++){
+   auto command=d[i];command.instances=1;command.firstInstance+=eye;eyeDraws[size_t(eye)*nd+i]=command;
+  }
+  draws=gkWorldBuffer(device,eyeDraws.data(),eyeDraws.size()*sizeof(*d),VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT,VK_PIPELINE_STAGE_DRAW_INDIRECT_BIT,VK_ACCESS_INDIRECT_COMMAND_READ_BIT);
+ }
+};
+}
