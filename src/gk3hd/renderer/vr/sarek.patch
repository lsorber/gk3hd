+  HRESULT D3D9XrMirror(void* device) {
+    auto* modern = static_cast<D3D9DeviceEx*>(device);
+    Com<IDirect3DSurface9> source, back;
+    HRESULT result = modern->GetRenderTarget(0, &source);
+    if (FAILED(result)) return result;
+    result = modern->GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &back);
+    if (FAILED(result)) return result;
+    if (source.ptr() != back.ptr()) {
+      result = modern->StretchRect(source.ptr(), nullptr, back.ptr(), nullptr, D3DTEXF_NONE);
+      if (FAILED(result)) return result;
+    }
+    return modern->Present(nullptr, nullptr, nullptr, nullptr);
+  }
