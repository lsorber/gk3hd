+inline bool sourceKey(IDirectDrawSurface* source) {
+  DDCOLORKEY key{};
+  return SUCCEEDED(source->GetColorKey(DDCKEY_SRCBLT,&key)) &&
+    key.dwColorSpaceLowValue==63519 && key.dwColorSpaceHighValue==63519;
+}
+
+inline HRESULT prepareReuse(const ReuseOwner& owner, bool sameLayout) {
+  pendingReuse=owner;
+  auto& retained=retainedGlyphs;
+  if (!sameLayout || !retained.owner.target || !owner.follows(retained.owner) ||
+      owner.target->IsLost()!=DD_OK || !sourceKey(owner.atlas)) {
+    retained.owner={};
+    return S_FALSE;
+  }
+  DDSURFACEDESC input{};
+  input.dwSize=sizeof(input);
+  if (FAILED(owner.atlas->Lock(nullptr,&input,DDLOCK_READONLY|DDLOCK_DONOTWAIT,nullptr))) {
+    retained.owner={};
+    return S_FALSE;
+  }
+  bool equal=atlasFormat(input) && input.dwWidth==retained.width && input.dwHeight==retained.height;
+  for (uint32_t y=0;equal && y<input.dwHeight;++y)
+    equal=std::memcmp(atlasRow(input,y),retained.pixels.data()+size_t(y)*input.dwWidth,
+      size_t(input.dwWidth)*sizeof(uint16_t))==0;
+  const auto result=owner.atlas->Unlock(input.lpSurface);
+  if (!equal || FAILED(result)) {
+    retained.owner={};
+    return FAILED(result)?result:S_FALSE;
+  }
+  retained.owner=owner;
+  return S_OK;
+}
+
+inline void rememberAtlas(const ReuseOwner& owner, const DDSURFACEDESC& input) {
+  if (!atlasFormat(input)) return;
+  auto& retained=retainedGlyphs;
+  try {
+    retained.pixels.resize(size_t(input.dwWidth)*input.dwHeight);
+  } catch (const std::bad_alloc&) {
+    return;
+  }
+  for (uint32_t y=0;y<input.dwHeight;++y)
+    std::memcpy(retained.pixels.data()+size_t(y)*input.dwWidth,atlasRow(input,y),
+      size_t(input.dwWidth)*sizeof(uint16_t));
+  retained.width=input.dwWidth;
+  retained.height=input.dwHeight;
+  retained.owner=owner;
+}
+
+
+inline void begin(IDirectDrawSurface* target,const uint32_t* busy) {
+  capture = Capture{};
+  capture.target=target;
+  capture.busy=busy;
+  if (pendingReuse.target==target && pendingReuse.busy==busy)
+    capture.reuse=pendingReuse;
+  else if (retainedGlyphs.owner.target==target && retainedGlyphs.owner.busy==busy)
+    retainedGlyphs.owner={};
+  pendingReuse={};
+}
+inline bool owns(IDirectDrawSurface* target) {
+  auto& c=capture;
+  if (c.target && !*c.busy) {
+    if (c.reuse.target) retainedGlyphs.owner={};
+    c=Capture{};
+  }
+  return c.target==target;
+}
