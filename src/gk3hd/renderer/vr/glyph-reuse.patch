+  DLLEXPORT HRESULT __stdcall Gk3hdXrGlyphReuseV1(
+      IDirectDrawSurface* target, IDirectDrawSurface* atlas, const uint32_t* busy,
+      uint32_t publication, uint32_t creations, uint32_t releases, uint32_t sameLayout) {
+#ifdef GK3HD_OPENXR
+    // This is an idle private capture destination, never a desktop page.
+    dxvk::status_batch::pendingReuse={};
+    if (!target || !atlas || target==atlas || !busy || *busy || sameLayout>1 ||
+        !dxvk::DDrawCommonInterface::IsWrappedSurface(target) ||
+        !dxvk::DDrawCommonInterface::IsWrappedSurface(atlas)) return E_INVALIDARG;
+    for (auto* surface : {target,atlas}) {
+      const auto* common=static_cast<dxvk::DDrawSurface*>(surface)->GetCommonSurface();
+      if (!common->IsInSystemMemory() || common->IsRenderTarget() || common->GetClipper())
+        return S_FALSE;
+    }
+    return dxvk::status_batch::prepareReuse({target,atlas,busy,publication,creations,releases},
+      sameLayout!=0);
+#else
+    return E_NOTIMPL;
+#endif
+  }
