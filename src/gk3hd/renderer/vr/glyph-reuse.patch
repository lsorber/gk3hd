+inline bool atlasFormat(const DDSURFACEDESC& desc) {
+  constexpr uint32_t maxPixels=512*1024;
+  return format(desc) && desc.dwWidth && desc.dwHeight &&
+    desc.dwWidth<=8192 && desc.dwHeight<=8192 &&
+    uint64_t(desc.dwWidth)*desc.dwHeight<=maxPixels && desc.lPitch<=32768;
+}
+
+inline const char* atlasRow(const DDSURFACEDESC& desc, uint32_t row) {
+  return static_cast<const char*>(desc.lpSurface)+size_t(row)*desc.lPitch;
+}
