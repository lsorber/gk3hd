+      IDirectDrawSurface* target, uint32_t operation, const uint32_t* busy) {
+#ifdef GK3HD_OPENXR
+    if (!target || !busy || *busy != 1 ||
+        !dxvk::DDrawCommonInterface::IsWrappedSurface(target)) return E_INVALIDARG;
+    if (operation == 1) return dxvk::status_batch::finish(target);
+    if (operation != 0) return E_INVALIDARG;
+    auto* common = static_cast<dxvk::DDrawSurface*>(target)->GetCommonSurface();
+    if (!common->IsInSystemMemory() || common->IsRenderTarget() || common->GetClipper())
+      return S_FALSE;
+    dxvk::status_batch::begin(target,busy);
+    return DD_OK;
+#else
+    return E_NOTIMPL;
+#endif
